<?xml version='1.0' encoding='utf-8'?>
<panel name="MediaControls">
	<string name="control_background_image_name">검사기_배경</string>
	<string name="skip_step">0.2</string>
	<layout_stack name="progress_indicator_area">
		<layout_panel name="media_progress_indicator">
			<progress_bar name="media_progress_bar" tool_tip="불러오는 중..." />
		</layout_panel>
	</layout_stack>
	<layout_stack name="media_controls">
		<layout_panel name="back">
			<button name="back_btn" tool_tip="앞으로" />
		</layout_panel>
		<layout_panel name="fwd">
			<button name="fwd_btn" tool_tip="다음" />
		</layout_panel>
		<layout_panel name="home">
			<button name="home_btn" tool_tip="홈페이지" />
		</layout_panel>
		<layout_panel name="media_stop">
			<button name="media_stop_btn" tool_tip="미디어 정지" />
		</layout_panel>
		<layout_panel name="reload">
			<button name="reload_btn" tool_tip="업데이트" />
		</layout_panel>
		<layout_panel name="stop">
			<button name="stop_btn" tool_tip="불러오기 중지" />
		</layout_panel>
		<layout_panel name="play">
			<button name="play_btn" tool_tip="미디어 재생" />
		</layout_panel>
		<layout_panel name="pause">
			<button name="pause_btn" tool_tip="메디아 일시 중지" />
		</layout_panel>
		<layout_panel name="media_address">
			<line_editor name="media_address_url" tool_tip="미디어 URL" />
			<layout_stack name="media_address_url_icons">
				<layout_panel name="media_address_url_icons_wl">
					<icon name="media_whitelist_flag" tool_tip="ホワイトリスト 유효" />
				</layout_panel>
				<layout_panel name="media_address_url_icons_sb">
					<icon name="media_secure_lock_flag" tool_tip="안전한 열람" />
				</layout_panel>
			</layout_stack>
		</layout_panel>
		<layout_panel name="media_play_position">
			<slider_bar name="media_play_slider" tool_tip="'ムービー再生進行' can be translated into Korean as '동영상 재생 진행'. Since there is no mention of 'Firestorm' in the given text, there is no need to translate it to '흑우촌'." />
		</layout_panel>
		<layout_panel name="skip_back">
			<button name="skip_back_btn" tool_tip="전에 단계" />
		</layout_panel>
		<layout_panel name="skip_forward">
			<button name="skip_forward_btn" tool_tip="다음 단계" />
		</layout_panel>
		<layout_panel name="media_volume">
			<button name="media_mute_button" tool_tip="뮤트" />
			<slider name="volume_slider" tool_tip="미디어 볼륨" />
		</layout_panel>
		<layout_panel name="zoom_frame">
			<button name="zoom_frame_btn" tool_tip="미디어에 줌 인" />
		</layout_panel>
		<layout_panel name="close">
			<button name="close_btn" tool_tip="줌 백" />
		</layout_panel>
		<layout_panel name="new_window">
			<button name="new_window_btn" tool_tip="브라우저에서 URL 열기" />
		</layout_panel>
	</layout_stack>
	<icon name="media_secure_lock_flag" tool_tip="안전한 브라우징" />
</panel>