<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="animation_explorer" title="애니메이션 탐색기">
	<scroll_list name="animation_list">
		<scroll_list.column label="재생자" name="played_by" />
		<scroll_list.column label="재생됨" name="played" />
		<scroll_list.column label="우선순위" name="priority" />
		<scroll_list.column label="시간" name="timestamp" />
		<scroll_list.column label="애니메이션 ID" name="animation_id" />
		<scroll_list.column label="객체 ID" name="object_id" />
	</scroll_list>
	<panel name="buttons_panel">
		<button label="중지" name="stop_btn" />
		<button label="중지 및 철회" name="stop_and_revoke_btn" />
		<button label="블랙리스트" name="blacklist_btn" />
		<check_box label="소유하지 않은 것만" name="no_owned_animations_check" tool_tip="활성화하면 아바타가 소유한 모든 애니메이션을 필터링합니다 (예: AO 애니메이션 또는 기본 시스템 애니메이션)" />
	</panel>
</floater>
