<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_pick_info">
	<panel.string name="location_notice">
		(저장 후 업데이트됨)
	</panel.string>
	<layout_stack name="main_pick_stack">
		<layout_panel name="main_pick_lp">
			<text name="title_label">
				제목:
			</text>
			<text name="description_label">
				설명:
			</text>
			<button name="btn_preview" tool_tip="추천장소 설명 미리보기 전환"/>
			<text name="location_label">
				위치:
			</text>
			<line_editor name="pick_location">
				로딩 중...
			</line_editor>
		</layout_panel>
		<layout_panel name="util_buttons_lp">
			<layout_stack name="util_buttons_stack">
				<layout_panel name="map_btn_lp">
					<button label="지도에 표시" name="show_on_map_btn"/>
				</layout_panel>
				<layout_panel name="tp_btn_lp">
					<button label="텔레포트" name="teleport_btn"/>
				</layout_panel>
				<layout_panel name="set_to_curr_location_btn_lp">
					<button label="위치 설정" name="set_to_curr_location_btn" tool_tip="현재 위치 사용"/>
				</layout_panel>
			</layout_stack>
		</layout_panel>
		<layout_panel name="save_changes_lp">
			<layout_stack name="save_changes_stack">
				<layout_panel name="create_btn_lp">
					<button name="create_changes_btn" label="추천장소 생성"/>
				</layout_panel>
				<layout_panel name="save_btn_lp">
					<button name="save_changes_btn" label="추천장소 저장"/>
				</layout_panel>
				<layout_panel name="cancel_btn_lp">
					<button name="cancel_changes_btn" label="취소"/>
				</layout_panel>
			</layout_stack>
		</layout_panel>
	</layout_stack>
</panel>
