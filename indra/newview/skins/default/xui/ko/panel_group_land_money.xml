<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel label="토지 및 L$" name="land_money_tab">
	<panel.string name="help_text">
		사용 중인 총 토지가 총 기여도보다 적거나 같을 때까지 경고가 표시됩니다.
	</panel.string>
	<panel.string name="cant_view_group_land_text">
		그룹 소유 토지를 볼 권한이 없습니다
	</panel.string>
	<panel.string name="epmty_view_group_land_text">
		항목 없음
	</panel.string>
	<panel.string name="cant_view_group_accounting_text">
		그룹의 회계 정보를 볼 권한이 없습니다.
	</panel.string>
	<panel.string name="loading_txt">
		로딩 중...
	</panel.string>
	<panel.string name="land_contrib_error">
		토지 기여도를 설정할 수 없습니다
	</panel.string>
	<scroll_list name="group_parcel_list">
		<scroll_list.columns label="구획" name="name"/>
		<scroll_list.columns label="지역" name="location"/>
		<scroll_list.columns label="유형" name="type"/>
		<scroll_list.columns label="면적" name="area"/>
		<scroll_list.columns label="숨김" name="hidden"/>
	</scroll_list>
	<button label="지도" label_selected="지도" name="map_button"/>
	<text name="total_land_in_use_label">
		사용 중인 총 토지:
	</text>
	<text name="total_land_in_use_value">
		[AREA] m²
	</text>
	<text name="land_available_label">
		사용 가능한 토지:
	</text>
	<text name="land_available_value">
		[AREA] m²
	</text>
	<text name="total_contributed_land_label">
		총 기여도:
	</text>
	<text name="total_contributed_land_value">
		[AREA] m²
	</text>
	<text name="your_contribution_label">
		귀하의 기여도:
	</text>
	<text name="your_contribution_units">
		m²
	</text>
	<text name="your_contribution_max_value">
		([AMOUNT] 최대)
	</text>
	<text name="group_money_heading">
		그룹 L$
	</text>
	<icon image_name="Parcel_Exp_Color" name="group_over_limit_icon"/>
	<text name="group_over_limit_text">
		사용 중인 토지를 지원하려면 더 많은 토지 크레딧이 필요합니다
	</text>

	<tab_container name="group_money_tab_container">
		<panel label="계획" name="group_money_planning_tab">
			<text_editor name="group_money_planning_text">
				로딩 중...
			</text_editor>
		</panel>
		<panel label="세부사항" name="group_money_details_tab">
			<text_editor name="group_money_details_text">
				로딩 중...
			</text_editor>
			<button label="&lt; 이전" label_selected="&lt; 이전" name="earlier_details_button" tool_tip="뒤로"/>
			<button label="다음 &gt;" label_selected="다음 &gt;" name="later_details_button" tool_tip="다음"/>
		</panel>
		<panel label="판매" name="group_money_sales_tab">
			<text_editor name="group_money_sales_text">
				로딩 중...
			</text_editor>
			<button label="&lt; 이전" label_selected="&lt; 이전" name="earlier_sales_button" tool_tip="뒤로"/>
			<button label="다음 &gt;" label_selected="다음 &gt;" name="later_sales_button" tool_tip="다음"/>
		</panel>
	</tab_container>
</panel>
