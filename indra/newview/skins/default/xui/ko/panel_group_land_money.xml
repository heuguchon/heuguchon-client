<?xml version='1.0' encoding='utf-8'?>
<panel label="토지와 L$" name="land_money_tab">
	<panel.string name="help_text">「土地 이용의 합계」가 「기부 총액」 이하 또는 같은 수준이 될 때까지 경고가 표시됩니다.</panel.string>
	<panel.string name="cant_view_group_land_text">그룹 소유지를 확인할 권한이 없습니다.</panel.string>
	<panel.string name="epmty_view_group_land_text">없음</panel.string>
	<panel.string name="cant_view_group_accounting_text">グループの会計情報を確認する権限がありません。
그룹의 회계 정보를 확인할 권한이 없습니다.</panel.string>
	<panel.string name="loading_txt">획득 중...</panel.string>
	<panel.string name="land_contrib_error">土地の貢献を設定することができません -&gt; 토지 기여도를 설정할 수 없습니다</panel.string>

	<scroll_list name="group_parcel_list">
		<scroll_list.columns label="구획" name="name" />
		<scroll_list.columns label="지역" name="location" />
		<scroll_list.columns label="종류" name="type" />
		<scroll_list.columns label="면적" name="area" />
		<scroll_list.columns label="비표시" name="hidden" />
	</scroll_list>
	<button label="지도" label_selected="지도" name="map_button" />
	<text name="total_land_in_use_label">토지 이용의 합계:</text>
	<text name="total_land_in_use_value">[AREA] 제곱미터</text>
	<text name="land_available_label">사용 가능한 토지:</text>
	<text name="land_available_value">[AREA] 제곱미터</text>
	<text name="total_contributed_land_label">기부 총액:</text>
	<text name="total_contributed_land_value">[AREA] 평방미터</text>
	<text name="your_contribution_label">당신의 기여:</text>
	<text name="your_contribution_units">제곱미터</text>
	<text name="your_contribution_max_value">(최대 [AMOUNT])</text>
	<text name="group_money_heading">그룹 L$</text>
	<text name="group_over_limit_text">토지 이용을 지원하기 위한 토지 크레딧이 부족합니다.</text>

	<tab_container name="group_money_tab_container">
		<panel label="계획" name="group_money_planning_tab">
			<text_editor name="group_money_planning_text">로드 중...</text_editor>
		</panel>
		<panel label="세부 사항" name="group_money_details_tab">
			<text_editor name="group_money_details_text">로드 중...</text_editor>
			<button name="earlier_details_button" tool_tip="전 주" />
			<button name="later_details_button" tool_tip="다음 주" />
		</panel>
		<panel label="판매 거래" name="group_money_sales_tab">
			<text_editor name="group_money_sales_text">로드 중...</text_editor>
			<button name="earlier_sales_button" tool_tip="지난 주" />
			<button name="later_sales_button" tool_tip="다음 주" />
		</panel>
	</tab_container>
</panel>