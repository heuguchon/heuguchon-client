<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="my_environments" title="내 환경">
	<layout_stack name="main_layout">
		<layout_panel label="필터" name="filter_panel">
			<check_box label="일간 주기" name="chk_days"/>
			<check_box label="하늘" name="chk_skies"/>
			<check_box label="물" name="chk_water"/>
			<filter_editor label="환경 필터" name="flt_search"/>
		</layout_panel>
		<layout_panel label="환경" name="list_panel">
			<panel label="pnl_inv_wrap" name="pnl_inv_wrap"/>
		</layout_panel>
		<layout_panel name="lp_showfolders">
			<check_box label="모든 폴더 표시" name="chk_showfolders"/>
		</layout_panel>
		<layout_panel name="pnl_control">
			<panel label="bottom_panel" name="pnl_bottom">
				<menu_button name="btn_gear" tool_tip="추가 옵션"/>
				<menu_button name="btn_newsettings" tool_tip="새 설정 만들기"/>
				<button name="btn_del" tool_tip="선택된 항목 삭제"/>
			</panel>
		</layout_panel>
	</layout_stack>
</floater>
