<!-- The layout is a vertical stack of 3 rows, and each row a horizontal stack of panels -->
	<layout_stack name="poser_stack">
		<layout_panel name="regular_controls_layout">
			<panel name="joints_parent_panel">
				<tab_container name="joints_tabs">
					<panel title="이동" name="positionRotation_panel">
						<panel name="title">
							<text name="av_position_updown_label">
								위/아래:
							</text>
							<slider name="av_position_updown" tool_tip="선택된 아바타를 위 또는 아래로 이동"/>
							<text name="av_position_leftright_label">
								좌/우:
							</text>
							<slider name="av_position_leftright" tool_tip="선택된 아바타를 왼쪽 또는 오른쪽으로 이동"/>
							<text name="av_position_inout_label">
								앞/뒤:
							</text>
							<slider name="av_position_inout" tool_tip="선택된 아바타를 앞 또는 뒤로 이동"/>
							<!-- so this panel behaves like the others in the code behind, it has an invisible list... -->
							<scroll_list name="entireAv_joint_scroll">
								<scroll_list.columns label="신체 부위" name="joint"/>
							</scroll_list>
						</panel>
					</panel>
					<panel title="몸체" name="body_joints_panel">
						<scroll_list name="body_joints_scroll">
							<scroll_list.columns label="신체 부위" name="joint"/>
						</scroll_list>
					</panel>
					<panel title="얼굴" name="face_joints_panel">
						<scroll_list name="face_joints_scroll">
							<scroll_list.columns label="신체 부위" name="joint"/>
						</scroll_list>
					</panel>
					<tab_container title="손" name="hands_tabs">
						<panel title="조정" name="hands_joints_panel">
							<scroll_list name="hand_joints_scroll">
								<scroll_list.columns label="신체 부위" name="joint"/>
							</scroll_list>
						</panel>
						<panel title="프리셋" name="hands_presets_panel">
							<scroll_list name="hand_presets_scroll">
								<scroll_list.columns label="프리셋 이름" name="name"/>
							</scroll_list>
							<button label="왼쪽 적용" name="button_loadHandPoseLeft" tool_tip="선택된 프리셋을 왼손에 적용하려면 클릭"/>
							<button label="오른쪽 적용" name="button_loadHandPoseRight" tool_tip="선택된 프리셋을 오른손에 적용하려면 클릭"/>
						</panel>
					</tab_container>
					<panel title="기타" name="misc_joints_panel">
						<scroll_list name="misc_joints_scroll">
							<scroll_list.columns label="신체 부위" name="joint"/>
						</scroll_list>
					</panel>
					<panel title="물리" name="collision_volumes_panel">
						<scroll_list name="collision_volumes_scroll">
							<scroll_list.columns label="물리" name="joint"/>
						</scroll_list>
					</panel>
					<panel title="모델" name="avatarSelection_panel">
						<scroll_list tool_tip="포즈를 취할 아바타나 애니메시를 선택하세요." name="avatarSelection_scroll">
							<scroll_list.columns label="선택..." name="name"/>
						</scroll_list>
						<button name="refresh_avatars" tool_tip="아바타와 애니메시 목록 새로 고침"/>
						<button label="포즈 시작" label_selected="포즈 중지" tool_tip="권한이 있는 경우 선택된 아바타나 애니메시의 포즈를 시작합니다" name="start_stop_posing_button"/>
						<button label="T자 포즈 설정" tool_tip="선택된 아바타를 T자 포즈로 설정하려면 클릭" name="set_t_pose_button"/>
					</panel>
					<panel title="설정" name="settings_panel">
						<text name="trackpad_sensitivity_label">
							트랙볼 민감도:
						</text>
						<slider name="trackpad_sensitivity_slider" tool_tip="트랙볼의 민감도를 조정합니다"/>
						<check_box name="stop_posing_on_close_checkbox" label="닫을 때 포즈 중지" tool_tip="닫을 때 포즈를 중지하지 않으면 지금까지의 작업을 잃지 않고 도움이 될 수 있습니다."/>
						<check_box name="reset_base_rotation_on_edit_checkbox" label="편집 시 기본 회전 재설정" tool_tip="포즈를 처음 편집할 때 이를 0으로 재설정합니다. 이렇게 하면 차이점만이 아닌 전체 포즈가 저장됩니다. 0 기반으로 내보낸 각 관절 옆에 녹색 체크 표시가 나타납니다."/>
						<check_box name="also_save_bvh_checkbox" label="저장 시 BVH 생성" tool_tip="포즈를 저장할 때 BVH 파일도 만들어집니다. 이는 빌드 > 업로드 > 애니메이션을 통해 업로드하고 자신의 아바타나 다른 아바타를 포즈하는 데 사용할 수 있습니다. 이를 위해서는 관절의 기준을 0으로 설정해야 합니다. BVH는 다른 포즈에서 파생되지 않기 때문입니다."/>
						<check_box name="confirm_overwrite_on_save_checkbox" label="덮어쓰기 확인" tool_tip="포즈를 저장할 때 파일이 이미 존재하는 경우, 파일을 덮어쓸 것인지 확인하기 위해 저장 버튼을 다시 클릭해야 합니다."/>
						<check_box name="natural_direction_checkbox" label="자연스러운 방향 사용" tool_tip="스켈레톤은 기본적으로 부자연스러운 관절 회전을 가지고 있어 포즈를 취하기 어렵게 만듭니다. 활성화되면 관절이 더 자연스러운 회전으로 설정됩니다."/>
						<check_box name="show_joint_markers_checkbox" label="관절 표시자 보기" tool_tip="포즈를 취할 때 관절 선택을 쉽게 하기 위해 표시자를 보여줍니다."/>
					</panel>
				</tab_container>
				<button name="toggleVisualManipulators" tool_tip="시각적 조작자 켜기/끄기" />
			</panel>
			<panel name="joint_manipulation_panel">
				<tab_container name="modifier_tabs">
