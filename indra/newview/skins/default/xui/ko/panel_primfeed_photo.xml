<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<panel name="panel_primfeed_photo">
	<combo_box name="resolution_combobox" tool_tip="이미지 해상도">
		<combo_box.item label="현재 창" name="CurrentWindow"/>
		<combo_box.item label="사용자 정의" name="Custom"/>
	</combo_box>
	<combo_box name="filters_combobox" tool_tip="이미지 필터">
		<combo_box.item label="필터 없음" name="NoFilter"/>
	</combo_box>
	<check_box label="비율 유지" name="keep_aspect_ratio"/>
	<text name="working_lbl">
		업데이트 중...
	</text>
	<check_box label="프레임 표시" name="show_frame" tool_tip="촬영 영역 주위에 프레임을 표시합니다. 촬영 영역 밖의 장면 부분은 채도가 낮아지고 약간 흐려집니다."/>
	<check_box label="가이드 표시" name="show_guides" tool_tip="촬영 영역 내에 촬영 가이드(3분할 법칙)를 표시합니다."/>
	<button label="새로 고침" name="new_snapshot_btn" tool_tip="새로 고침하려면 클릭"/>
	<button label="미리보기" name="big_preview_btn" tool_tip="미리보기를 켜거나 끄려면 클릭"/>
	<text name="store_label">
		다음으로 공유:
	</text>
	<combo_box name="stores_combobox" tool_tip="Primfeed에서 하나 이상의 블로거 스토어가 할당된 경우 여기에 표시됩니다."/>
	<text name="description_label">
		설명:
	</text>
	<check_box initial_value="true" label="설명에 위치 추가" name="add_location_cb"/>
	<check_box label="공개 갤러리에 추가" name="primfeed_add_to_public_gallery"/>
	<check_box label="상업적 콘텐츠" name="primfeed_commercial_content"/>
	<combo_box name="rating_combobox" tool_tip="Primfeed 콘텐츠 등급">
		<combo_box.item label="일반" name="GeneralRating"/>
		<combo_box.item label="보통" name="ModerateRating"/>
		<combo_box.item label="성인" name="AdultRating"/>
		<combo_box.item label="성인+" name="AdultPlusRating"/>
	</combo_box>
	<check_box label="게시 후 브라우저에서 열기" tool_tip="Primfeed 게시물을 브라우저에서 자동으로 엽니다." name="primfeed_open_url_on_post"/>
	<button label="공유" name="post_photo_btn"/>
	<button label="취소" name="cancel_photo_btn"/>
</panel>
