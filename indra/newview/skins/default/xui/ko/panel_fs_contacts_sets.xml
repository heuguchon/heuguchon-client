<?xml version='1.0' encoding='utf-8'?>
<panel name="contact_sets_panel">
	<panel.string name="empty_list">연락처 세트에 아무것도 등록되어 있지 않습니다.</panel.string>
	<panel.string name="no_sets">셋트 미등록</panel.string>
	<panel.string name="all_sets">모든 세트</panel.string>
	<panel.string name="pseudonyms">닉네임</panel.string>
	<panel.string name="non_friends">친구가 아닌 사람</panel.string>
	<combo_box name="combo_sets" />
	<button name="config_btn" tool_tip="선택한 연락처 세트의 설정을 합니다." />
	<button name="add_set_btn" tool_tip="새로운 연락처 세트를 추가합니다." />
	<button name="remove_set_btn" tool_tip="선택한 연락처 세트를 삭제합니다." />
	<avatar_list name="contact_list" />
    
	<button label="추가..." name="add_btn" tool_tip="아바타를 현재 연락처 세트에 추가합니다." />
	<button label="삭제..." name="remove_btn" tool_tip="이 아바타를 현재의 연락처 세트에서 삭제합니다." />
	<button label="프로필..." name="profile_btn" tool_tip="이 아바타의 프로필을 엽니다." />
	<button label="IM (인스턴트 메시지)" name="start_im_btn" tool_tip="IM을 시작합니다." />
	<button label="텔레포트..." name="offer_teleport_btn" tool_tip="당신이 현재 있는 장소로 순간 이동을 통해 부를 것입니다." width="80" />
	<button label="닉네임 설정..." name="set_pseudonym_btn" tool_tip="이 아바타의 닉네임을 설정합니다." />
	<button label="닉네임 해제..." name="remove_pseudonym_btn" tool_tip="아바타의 닉네임을 삭제합니다" />
	<button label="表示名削除... -&gt; 표시명 삭제..." name="remove_displayname_btn" tool_tip="아바타의 표시 이름을 삭제합니다." />
	<text name="member_count">회원 수: [COUNT]</text>
</panel>