<?xml version='1.0' encoding='utf-8'?>
<floater name="ColorPicker" title="색상 선택기">
	<tab_container name="color_type_container">
		<panel name="RGB" label="RGB">
			<text name="r_val_text">빨강:</text>
			<spinner name="rspin" />
			<text name="g_val_text">초록:</text>
			<spinner name="gspin" />
			<text name="b_val_text">파란색：</text>
			<spinner name="bspin" />
		</panel>
		<panel name="LSL" label="LSL">
			<text name="r_val_text_float">Here is the translation for the text related to the SecondLife Viewer, with 'Firestorm' translated to '흑우촌':

赤: 레드</text>
			<spinner decimal_digits="3" name="rspin_float" />
			<text name="g_val_text_float">녹색:</text>
			<spinner decimal_digits="3" name="gspin_float" />
			<text name="b_val_text_float">파란 색:</text>
			<spinner decimal_digits="3" name="bspin_float" />
		</panel>
	</tab_container>
	<text name="h_val_text">색조:</text>
	<spinner name="hspin" />
	<text name="s_val_text">채도:</text>
	<spinner name="sspin" />
	<text name="l_val_text">밝기:</text>
	<spinner name="lspin" />
	<text name="hex_text">헥스 #</text>
	<line_editor name="hex_value" />
	<check_box label="즉시 적용" name="apply_immediate" />
	<button name="color_pipette" />
	<button label="알겠습니다!&#10;&#10;ＯＫ" name="select_btn" />
	<button label="취소" label_selected="취소" name="cancel_btn" />
	<text tool_tip="팔레트 아래로 드래그하여 저장" name="Current color:">현재의 색:</text>
	<menu_button menu_filename="menu_copy_color_picker.xml" name="clipboard_color" tool_tip="색상 복사 옵션" />
</floater>