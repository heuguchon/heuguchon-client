<?xml version='1.0' encoding='utf-8'?>
<floater name="floater_placedetails" title="랜드마크">
	<string name="title_place">토지 세부 정보</string>
	<string name="title_remote_place">토지의 상세 정보</string>
	<string name="title_remote_place_detail">토지의 상세 정보: [NAME]</string>
	<string name="title_landmark">랜드마크</string>
	<string name="title_landmark_detail">랜드마크: [NAME]</string>
	<string name="title_create_landmark">랜드마크를 생성</string>
	<string name="title_teleport_history_item">텔레포트 기록의 상세 정보: [NAME]</string>
	<panel filename="panel_landmark_info.xml" name="panel_landmark_info" />
	<panel filename="panel_place_profile.xml" name="panel_place_profile" />

	<panel name="button_panel">
		<layout_stack name="bottom_bar_ls0" orientation="horizontal">

			<layout_panel name="lp1">

				<layout_stack name="bottom_bar_ls1" orientation="horizontal">
					<layout_panel name="teleport_btn_lp">
						<button label="텔레포트" name="teleport_btn" tool_tip="선택한 지역으로 텔레포트합니다." />
					</layout_panel>

					<layout_panel name="map_btn_lp">
						<button label="지도" name="map_btn" tool_tip="해당 지역을 세계 지도에 표시합니다." />
					</layout_panel>

					<layout_panel name="edit_btn_lp">
						<button label="편집" name="edit_btn" tool_tip="이 랜드마크를 편집합니다." />
					</layout_panel>

					<layout_panel name="overflow_btn_lp">
						<menu_button name="overflow_btn" tool_tip="추가 옵션을 표시합니다." />
					</layout_panel>
				</layout_stack>
			</layout_panel>	
		</layout_stack>

		<layout_stack name="bottom_bar_ls1" orientation="horizontal">
			<layout_panel name="lp2">

				<layout_stack name="bottom_bar_close_ls3" orientation="horizontal">
					<layout_panel name="close_btn_lp">
						<button label="닫기" name="close_btn" />
					</layout_panel>
				</layout_stack>

			</layout_panel>
		</layout_stack>	
	 
		<layout_stack name="bottom_bar_ls2" orientation="horizontal">

			<layout_panel name="save_btn_lp">
				<button label="저장" name="save_btn" />
			</layout_panel>

			<layout_panel name="cancel_btn_lp">
				<button label="취소" name="cancel_btn" />
			</layout_panel>
		</layout_stack>
	</panel>
</floater>