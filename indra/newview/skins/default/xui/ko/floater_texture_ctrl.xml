<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 legacy_header_height="18"
 can_minimize="false"
 can_resize="true"
 height="360"
 layout="topleft"
 min_height="330"
 min_width="410"
 name="texture picker"
 help_topic="texture_picker"
 title="선택: 텍스처"
 width="410">
 
<!--  상단 정적 -->
 <floater.string
     name="choose_picture">
        그림을 선택하려면 클릭하세요
    </floater.string>
    <floater.string
     name="pick title">
선택:
    </floater.string>
    <floater.string
     name="pick_material">
선택: 머티리얼
    </floater.string>
    <floater.string
     name="pick_texture">
선택: 텍스처
    </floater.string>

    <view
     left="4"
     top="20"
     name="preview_widget"
     height="165"
     width="165"
     follows="left|top"
    />
  
    <text
     type="string"
     length="1"
     follows="left|top"
     text_color="White"
     font="SansSerifBig"
     halign="center"
     height="17"
     layout="topleft"
     left="4"
     name="Multiple"
     top="96"
     width="163">
        다중 텍스처
    </text>
	
	<!-- 모드 선택기 -->
   <radio_group
     height="20"
     layout="topleft"
     left="0"
     top_pad="80"
     name="mode_selection"
     follows="left|top">
        <radio_item
         label="인벤토리"
         name="inventory"
         top_delta="20" 
         layout="topleft"
         height="16" 
         left="0" 
         value="0"
         width="70" />
        <radio_item
         label="로컬"
         left_pad="0"
         layout="topleft"
         top_delta="0" 
         height="16" 
         name="local"
         value="1"
         width="50" />
       <radio_item
         label="베이크"
         left_pad="0"
         layout="topleft"
         top_delta="0"
         height="16"
         name="bake"
         value="2"
         width="50" />
    </radio_group>
	<!-- -->
	
    <text
     type="string"
     length="1"
     follows="left|top"
     height="14"
     layout="topleft"
     left="8"
     name="size_lbl"
     top_pad="1">
        크기:
[DIMENSIONS]
    </text>
    <text
     type="string"
     text_color="Yellow"
     length="1"
     word_wrap="true"
     follows="left|top"
     height="56"
     width="164"
     layout="topleft"
     left="8"
     name="over_limit_lbl"
     visible="false"
     top_delta="0">
        선택한 텍스처는 [TEXDIM]입니다. 인벤토리 이미지는 정사각형이어야 하며 최소 [MINTEXDIM]이어야 합니다.
    </text>
    
<!--  중간: 인벤토리 모드 -->

    <button
     enabled="false"
     follows="left|top"
     height="18"
     label="기본값"
     label_selected="기본값"
     layout="topleft"
     name="Default"
     width="73"
	 left="94"
     top="215"/>
    <button
     follows="left|top"
     height="18"
     label="빈 화면"
     label_selected="빈 화면"
     layout="topleft"
     left_delta="0"
     name="Blank"
     top_pad="0"
     width="73" />
    <button
     follows="left|top"
     height="18"
     label="투명"
     label_selected="투명"
     layout="topleft"
     left_delta="0"
     name="Transparent"
     tool_tip="참고: 투명 텍스처 또는 부분 투명도가 있는 다른 텍스처가 선택되면 빛이 투사되지 않습니다."
     top_pad="0"
     width="73" />
     <button
     enabled="false"
     follows="left|top"
     height="18"
     label="없음"
     label_selected="없음"
     layout="topleft"
     left_delta="0"
     name="None"
     top_pad="0"
     width="73" />
    <button
     follows="left|top"
     height="28"
     image_selected="eye_button_active.tga"
     image_unselected="eye_button_inactive.tga"
     layout="topleft"
     left_delta="-80"
     top_delta="-25"
     name="Pipette"
     width="28" />
   <text
     follows="left|bottom"
     height="40"
     layout="topleft"
     left="8"
     name="preview_disabled"
     top="275"
     value="미리보기 비활성화"
     word_wrap="true"
     visible="false"
     width="87" />  
    <filter_editor
     follows="left|top|right"
     height="23"
     label="텍스처 필터"
     layout="topleft"
     left="175"
     name="inventory search editor"
     top="20"
     width="231" />
    <asset_filtered_inv_panel
     allow_multi_select="false"
     bg_visible="true"
     bg_alpha_color="DkGray2"
     border="false"
     follows="all"
     height="242"
     layout="topleft"
     left_delta="0"
     name="inventory panel"
     top_pad="4"
     width="231"
     filter_asset_types="texture|material"/>

<!--  중간: 로컬 모드 -->
    <button
     follows="left|top"
     height="18"
     label="추가"
     label_selected="추가"
     layout="topleft"
     left="94"
     top="215"
     name="l_add_btn"
     width="73"
     visible="false"/>
    <button
     enabled="false"
     follows="left|top"
     height="20"
     label="제거"
     label_selected="제거"
     layout="topleft"
     left_delta="0"
     name="l_rem_btn"
     top_pad="5"
     width="73"
     visible="false"/>
    <button
     enabled="false"
     follows="left|top"
     height="20"
     label="업로드"
     label_selected="업로드"
     layout="topleft"
     left_delta="0"
     name="l_upl_btn"
     top_pad="5"
     width="73"
     visible="false"/>
    <scroll_list
     name="l_name_list"
     left="175"
     top="22"
     width="230"
     height="260"
     follows="left|top|right|bottom"
     column_padding="0"
     draw_heading="true"
     multi_select="true"
     search_column="1"
     visible="false">
        <column name="icon" label="" width="20" />
        <column name="unit_name" label="이름" dynamicwidth="true" />
    </scroll_list>

<!-- 중간: 베이크 모드 -->
  <combo_box
         left="180"
         top="30"
			   height="19"
			   top_delta="15"
			   layout="topleft"
			   follows="left|top"
			   name="l_bake_use_texture_combo_box"
			   tool_tip="베이크 텍스처 선택"
			   width="118"
         visible="false">
        <combo_box.item
         label="없음"
         name="None"
         value="-1" />
        <combo_box.item
         label="베이크된_머리"
         name="BAKED_HEAD"
         value="0" />
        <combo_box.item
         label="베이크된_상체"
         name="BAKED_UPPER"
         value="1" />
        <combo_box.item
         label="베이크된_하체"
         name="BAKED_LOWER"
         value="2" />
        <combo_box.item
         label="베이크된_눈"
         name="BAKED_EYES"
         value="3" />
        <combo_box.item
         label="베이크된_치마"
         name="BAKED_SKIRT"
         value="4" />
        <combo_box.item
         label="베이크된_머리카락"
         name="BAKED_HAIR"
         value="5" />
        <combo_box.item
          label="베이크된_왼팔"
          name="BAKED_LEFTARM"
          value="6" />
        <combo_box.item
          label="베이크된_왼다리"
          name="BAKED_LEFTLEG"
          value="7" />
        <combo_box.item
         label="베이크된_보조1"
         name="BAKED_AUX1"
         value="8" />
        <combo_box.item
           label="베이크된_보조2"
           name="BAKED_AUX2"
           value="9" />
        <combo_box.item
         label="베이크된_보조3"
         name="BAKED_AUX3"
         value="10" />
  </combo_box>
<!-- 하단 정적 -->
    <line_editor
        follows="bottom"
        height="20"
        left="7"
        top="-55"
        max_length_chars="256"
        name="TextureKey"
        layout="topleft"
        label="00000000-0000-0000-0000-000000000000"
        tool_tip="텍스처 키"
        width="290"/>
    <button
        follows="bottom"
        name="TextureKeyApply"
        height="20"
        label="UUID 적용"
        layout="topleft"
        left_pad="5"
        width="100"
        tool_tip="이 UUID 적용"/>
    <button
     follows="bottom"
     height="20"
     label="확인"
     label_selected="확인"
     layout="topleft"
     left="176"
     top="-30"
     name="Select"
     width="100" />
    <button
     follows="bottom"
     height="20"
     label="취소"
     label_selected="취소"
     layout="topleft"
     left_delta="120"
     top_delta="0"
     name="Cancel"
     width="100" />
    <check_box
     follows="left|bottom"
     height="20"
     initial_value="true"
     label="지금 적용"
     layout="topleft"
     left="5"
     name="apply_immediate_check"
     top_delta="0"
     width="150" />
</floater>
