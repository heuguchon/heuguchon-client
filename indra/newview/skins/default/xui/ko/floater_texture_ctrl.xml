<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="texture picker" title="선택: 텍스처">
	<floater.string name="choose_picture">
		그림을 선택하려면 클릭하세요
	</floater.string>
	<floater.string name="pick title">
		선택:
	</floater.string>
	<floater.string name="pick_material">
		선택: 머티리얼
	</floater.string>
	<floater.string name="pick_texture">
		선택: 텍스처
	</floater.string>
	<text name="Multiple">
		다중 텍스처
	</text>
	<radio_group name="mode_selection">
		<radio_item label="인벤토리" name="inventory" width="70"/>
		<radio_item label="로컬" name="local" width="50"/>
		<radio_item label="베이크" name="bake"/>
	</radio_group>
	<text name="size_lbl">
		크기:
[DIMENSIONS]
	</text>
	<text name="over_limit_lbl">
		선택한 텍스처는 [TEXDIM]입니다. 인벤토리 이미지는 정사각형이어야 하며 [MINTEXDIM]과 [MAXTEXDIM] 사이여야 합니다.
	</text>
	<button label="기본값" label_selected="기본값" name="Default"/>
	<button label="없음" label_selected="없음" name="None"/>
	<button label="빈 화면" label_selected="빈 화면" name="Blank"/>
	<button label="투명" label_selected="투명" name="Transparent" tool_tip="참고: 투명 텍스처 또는 부분 투명도가 있는 다른 텍스처가 선택되면 빛이 투사되지 않습니다."/>
	<button label="" label_selected="" name="Pipette"/>
	<text name="preview_disabled">
		미리보기 비활성화
	</text>
	<filter_editor label="텍스처 필터" name="inventory search editor"/>
	<button label="추가" label_selected="추가" name="l_add_btn"/>
	<button label="제거" label_selected="제거" name="l_rem_btn"/>
	<button label="업로드" label_selected="업로드" name="l_upl_btn"/>
	<scroll_list name="l_name_list">
		<column name="unit_name" label="이름"/>
		<column name="unit_id_HIDDEN" label="ID"/>
	</scroll_list>
	<combo_box name="l_bake_use_texture_combo_box" tool_tip="베이크 텍스처 선택">
		<combo_box.item label="없음" name="None"/>
		<combo_box.item label="베이크된_머리" name="BAKED_HEAD"/>
		<combo_box.item label="베이크된_상체" name="BAKED_UPPER"/>
		<combo_box.item label="베이크된_하체" name="BAKED_LOWER"/>
		<combo_box.item label="베이크된_눈" name="BAKED_EYES"/>
		<combo_box.item label="베이크된_치마" name="BAKED_SKIRT"/>
		<combo_box.item label="베이크된_머리카락" name="BAKED_HAIR"/>
		<combo_box.item label="베이크된_왼팔" name="BAKED_LEFTARM"/>
		<combo_box.item label="베이크된_왼다리" name="BAKED_LEFTLEG"/>
		<combo_box.item label="베이크된_보조1" name="BAKED_AUX1"/>
		<combo_box.item label="베이크된_보조2" name="BAKED_AUX2"/>
		<combo_box.item label="베이크된_보조3" name="BAKED_AUX3"/>
	</combo_box>
	<line_editor name="TextureKey" tool_tip="텍스처 UUID"/>
	<button name="TextureKeyApply" label="UUID 적용" tool_tip="이 UUID로 텍스처 적용"/>
	<button label="취소" label_selected="취소" name="Cancel"/>
	<button label="확인" label_selected="확인" name="Select" left="135"/>
	<check_box label="지금 적용" name="apply_immediate_check"/>
</floater>
