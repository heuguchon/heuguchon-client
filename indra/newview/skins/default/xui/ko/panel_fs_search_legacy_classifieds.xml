<?xml version='1.0' encoding='utf-8'?>
<panel label="클래시파이드 광고" name="panel_ls_classifieds">

	<panel name="panel_ls_input">
		<text name="search_text">검색 키워드를 입력해 주세요:</text>
		<search_combo_box name="classifieds_edit" />
		<combo_box name="classifieds_category" />
		<check_box label="알겠습니다! 번역할 텍스트를 제공해 주세요." name="pg_all" />
		<icon name="rating_icon_general" />
		<check_box label="알겠습니다. 번역할 텍스트를 제공해 주시면 'Firestorm'을 '흑우촌'으로 변환하여 번역해 드리겠습니다." name="mature_all" />
		<icon name="rating_icon_moderate" />
		<check_box label="Sure! Please provide the text you'd like to translate." name="adult_all" />
		<icon name="rating_icon_adult" />
	</panel>
	
	
	<panel name="panel_ls_scrolllist">
		<scroll_list name="search_results_classifieds">
			<columns name="icon" />
			<columns label="이름" name="classified_name" />
			<columns label="표시 가격" name="price" />
		</scroll_list>
		<button label="돌아가기" name="classifieds_back" />
		<button label="다음" name="classifieds_next" />
	</panel>
	
</panel>