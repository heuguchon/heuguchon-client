<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="navigation_bar">
	<layout_stack name="navigation_favorites_bar_visibility_stack">
		<layout_panel name="navigation_bar_visibility_panel">
			<layout_stack name="location_search_layout">
				<layout_panel name="navigation_buttons_visibility_panel">
					<pull_button name="back_btn" tool_tip="이전 위치로 돌아가기"/>
					<pull_button name="forward_btn" tool_tip="다음 위치로 이동"/>
					<button name="home_btn" tool_tip="집으로 텔레포트"/>
					<button name="About_Land" label="토지" tool_tip="토지 정보 창 열기"/>
					<button name="PersonalLighting" label="조명" tool_tip="개인 조명 창 열기"/>
				</layout_panel>
				<layout_panel name="location_bar_visibility_panel">
					<location_input label="위치" name="location_combo"/>
				</layout_panel>
				<layout_panel name="search_bar_visibility_panel">
					<search_combo_box label="검색" name="search_combo_box" tool_tip="검색">
						<combo_editor label="메타버스 검색" name="search_combo_editor"/>
					</search_combo_box>
				</layout_panel>
			</layout_stack>
		</layout_panel>
		<layout_panel name="favorites_bar_visibility_panel">
			<favorites_bar name="favorite" tool_tip="즐겨찾는 장소에 빠르게 접근하려면 랜드마크를 여기로 드래그하세요!">
				<label name="favorites_bar_label" tool_tip="즐겨찾는 장소에 빠르게 접근하려면 랜드마크를 여기로 드래그하세요!">
					즐겨찾기 바
				</label>
				<chevron_button name="more_btn" tool_tip="내 즐겨찾기 더 보기"/>
			</favorites_bar>
		</layout_panel>
	</layout_stack>
</panel>
