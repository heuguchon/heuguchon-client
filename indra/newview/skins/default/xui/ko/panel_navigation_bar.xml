<?xml version='1.0' encoding='utf-8'?>
<panel name="navigation_bar">

<layout_stack name="navigation_favorites_bar_visibility_stack">

	<layout_panel name="navigation_bar_visibility_panel">

		<layout_stack name="location_search_layout">

			<layout_panel name="navigation_buttons_visibility_panel">

				<pull_button name="back_btn" tool_tip="이전 위치로 이동" />
				<pull_button name="forward_btn" tool_tip="다음 장소로 이동" />
				<button name="home_btn" tool_tip="「홈」으로 텔레포트합니다." />
				<button name="About_Land" label="토지" tool_tip="토지 정보 창을 엽니다." /> 
				<button name="PersonalLighting" label="조명" tool_tip="개인 조명의 창을 엽니다." />

			</layout_panel>

			<layout_panel name="location_bar_visibility_panel">

				<location_input label="장소" name="location_combo">
				</location_input>
					<combo_list mouse_wheel_opaque="true" />

			</layout_panel>

			<layout_panel name="search_bar_visibility_panel">

				<search_combo_box label="검색" name="search_combo_box">
					<combo_editor label="메타버스 내 검색" />
					<combo_list draw_border="true" border.highlight_light_color="FocusColor" border.highlight_dark_color="FocusColor" border.shadow_light_color="FocusColor" border.shadow_dark_color="FocusColor" mouse_wheel_opaque="true" />
				</search_combo_box>

			</layout_panel>

		</layout_stack>
		
	</layout_panel>

	<layout_panel name="favorites_bar_visibility_panel">

		<favorites_bar name="favorite" tool_tip="랜드마크를 여기에 드래그하여, Second Life의 즐겨찾는 장소에 신속하게 접근하세요!">
			<label name="favorites_bar_label" tool_tip="랜드마크를 여기에 드래그하여, 흑우촌에서 원하는 장소에 빠르게 접근하세요!">즐겨찾기 바</label>
		</favorites_bar>

	</layout_panel>


</layout_stack>

</panel>