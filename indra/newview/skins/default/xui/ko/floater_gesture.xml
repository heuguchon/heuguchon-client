<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater label="장소" name="gestures" title="제스처">
	<floater.string name="loading">
		로딩 중...
	</floater.string>
	<floater.string name="playing">
		(재생 중)
	</floater.string>
	<floater.string name="copy_name">
		[COPY_NAME]의 복사본
	</floater.string>
	<scroll_list name="gesture_list">
		<scroll_list.columns label="이름" name="name"/>
		<scroll_list.columns label="채팅" name="trigger"/>
		<scroll_list.columns label="" name="key"/>
		<scroll_list.columns label="키" name="shortcut"/>
	</scroll_list>
	<panel label="bottom_panel" name="bottom_panel">
		<menu_button name="gear_btn" tool_tip="더 많은 옵션"/>
		<button name="new_gesture_btn" tool_tip="새 제스처 만들기"/>
		<button name="activate_btn" tool_tip="선택한 제스처 활성화/비활성화"/>
		<check_box label="활성화된 것만" name="FSShowOnlyActiveGestures"/>
		<button name="del_btn" tool_tip="이 제스처 삭제"/>
	</panel>
	<button label="편집" name="edit_btn" tool_tip="선택한 제스처를 편집할 창을 엽니다."/>
	<button label="재생" name="play_btn" tool_tip="선택한 제스처를 월드에서 실행합니다."/>
	<button label="중지" name="stop_btn"/>
</floater>