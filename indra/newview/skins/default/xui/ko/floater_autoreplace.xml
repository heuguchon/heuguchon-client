<?xml version='1.0' encoding='utf-8'?>
<floater name="autoreplace_floater" title="자동 교체 설정">
	<check_box label="자동 교체를 활성화하기" name="autoreplace_enable" tool_tip="채팅 텍스트를 입력하면서 입력한 키워드를 대응하는 치환 키워드로 교체합니다." />
	<button label="リストをインポート… (リスト를 インポート…)" name="autoreplace_import_list" tool_tip="이전에 내보낸 목록을 파일에서 로드합니다." />
	<button label="리스트 내보내기…" name="autoreplace_export_list" tool_tip="선택한 리스트를 파일에 저장하여 공유할 수 있도록 합니다." />
	<button label="신규 리스트…" name="autoreplace_new_list" tool_tip="신규 리스트를 작성합니다." />
	<button label="리스트를 삭제" name="autoreplace_delete_list" tool_tip="선택한 목록을 삭제합니다." />
	<button name="autoreplace_list_up" tool_tip="이 목록의 우선순위를 높입니다." />
	<button name="autoreplace_list_down" tool_tip="이 리스트의 우선순위를 낮춥니다." />
	<scroll_list name="autoreplace_list_replacements">
		<scroll_list.columns label="키워드" name="keyword" />
		<scroll_list.columns label="대체" name="replacement" />
	</scroll_list>
	<button label="추가..." name="autoreplace_add_entry" />
	<button label="삭제" name="autoreplace_delete_entry" />
	<text name="autoreplace_keyword_txt">키워드:</text>
	<text name="autoreplace_replacement_txt">치환:</text>
	<button label="エントリを保存 (Entryを保存) - 항목 저장" name="autoreplace_save_entry" tool_tip="이 항목을 저장합니다." />
	<button label="변경 사항을 저장" name="autoreplace_save_changes" tool_tip="변경을 모두 저장합니다." />
	<button label="취소" name="autoreplace_cancel" tool_tip="모든 변경 내용을 취소합니다." />
</floater>