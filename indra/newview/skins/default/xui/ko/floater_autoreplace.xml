<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="autoreplace_floater" title="자동 치환 설정">
	<check_box label="자동 치환 활성화" name="autoreplace_enable" tool_tip="채팅 텍스트를 입력할 때 입력된 키워드를 해당하는 치환 텍스트로 교체합니다"/>
	<button label="목록 가져오기..." name="autoreplace_import_list" tool_tip="파일에서 이전에 내보낸 목록을 불러옵니다."/>
	<button label="목록 내보내기..." name="autoreplace_export_list" tool_tip="선택한 목록을 파일로 저장하여 공유할 수 있습니다."/>
	<button label="새 목록..." name="autoreplace_new_list" tool_tip="새 목록을 만듭니다."/>
	<button label="목록 삭제" name="autoreplace_delete_list" tool_tip="선택한 목록을 삭제합니다."/>
	<button name="autoreplace_list_up" tool_tip="이 목록의 우선순위를 위로 이동합니다."/>
	<button name="autoreplace_list_down" tool_tip="이 목록의 우선순위를 아래로 이동합니다."/>
	<scroll_list name="autoreplace_list_replacements">
		<scroll_list.columns label="키워드" name="keyword"/>
		<scroll_list.columns label="치환 텍스트" name="replacement"/>
	</scroll_list>
	<button label="추가..." name="autoreplace_add_entry"/>
	<button label="제거" name="autoreplace_delete_entry"/>
	<text name="autoreplace_keyword_txt">
		키워드:
	</text>
	<text name="autoreplace_replacement_txt">
		치환 텍스트:
	</text>
	<button label="항목 저장" name="autoreplace_save_entry" tool_tip="이 항목을 저장합니다."/>
	<button label="변경 사항 저장" name="autoreplace_save_changes" tool_tip="모든 변경 사항을 저장합니다."/>
	<button label="취소" name="autoreplace_cancel" tool_tip="모든 변경 사항을 취소합니다."/>
</floater>
