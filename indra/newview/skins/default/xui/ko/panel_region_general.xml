	<button label="모든 거주자를 홈으로 텔레포트..." name="kick_all_btn"/>
	<button label="지역에 메시지 보내기..." name="im_btn"/>
	<button label="텔레허브 관리..." name="manage_telehub_btn"/>
	<button label="재시작 스케줄 관리..." name="manage_restart_btn"/>
