<?xml version='1.0' encoding='utf-8'?>
<panel label="객체" name="objects panel">
	<panel label="Sure, please provide the text you would like to be translated to Korean." name="sidepanel_inventory_panel">
		<layout_stack name="inventory_layout_stack">
			<layout_panel name="main_inventory_layout_panel">
				<panel label="Sure, please provide the text you'd like translated." name="panel_main_inventory" />
			</layout_panel>
			<layout_panel name="inbox_layout_panel">
				<panel name="marketplace_inbox" label="Sure, please provide the text you would like to be translated.">
					<string name="InboxLabelWithArg">받은 아이템 ([NUM]개)</string>
					<string name="InboxLabelNoArg">수신된 아이템</string>
					<button label="받은 아이템" name="inbox_btn" />
					<text name="inbox_fresh_new_count">[NUM]개의 신상품</text>
					<panel name="inbox_inventory_placeholder_panel" tool_tip="아이템을 사용하려면, 그 아이템을 인벤토리에 드래그 앤 드롭하십시오.">
						<text name="inbox_inventory_placeholder">마켓플레이스에서 구매한 상품은 여기에 배달됩니다.</text>
					</panel>
				</panel>
			</layout_panel>
		</layout_stack>
		<panel name="button_panel">
			<layout_stack name="button_panel_ls">
				<layout_panel name="info_btn_lp">
					<button label="프로필" name="info_btn" tool_tip="객체의 프로필을 표시하기" />
				</layout_panel>
				<layout_panel name="share_btn_lp">
					<button label="공유" name="share_btn" tool_tip="인벤토리 내의 아이템을 공유합니다." />
				</layout_panel>
				<layout_panel name="shop_btn_lp">
					<button label="쇼핑" name="shop_btn" tool_tip="마켓플레이스 사이트 열기" />
					<button label="장착" name="wear_btn" tool_tip="선택한 아웃핏을 착용합니다." />
					<button label="재생" name="play_btn" />
					<button label="텔레포트" name="teleport_btn" tool_tip="해당 지역으로 텔레포트합니다." />
				</layout_panel>
			</layout_stack>
		</panel>
	</panel>
</panel>