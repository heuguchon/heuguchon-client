<?xml version='1.0' encoding='utf-8'?>
<panel label="그룹 생성" name="GroupCreation">
    <panel.string name="current_membership">(自分の회비)</panel.string>
    <panel name="group_info_top">
        <text name="group_name_label">그룹 이름:</text>
        <line_editor label="여기에 새로운 그룹 이름을 입력하세요" name="group_name_editor" />
    </panel>

    <scroll_container name="content_scroll_container">
        <panel name="content_panel">

            <layout_stack name="layout">
                <layout_panel name="group_info">
                    <panel name="group_info_top2">
                        <texture_picker name="insignia" label="Sure, please provide the text you would like translated." />
                        <text_editor name="charter">그룹의 이념, 지침</text_editor>
                    </panel>
                    <panel name="preferences_container">
                        <check_box label="누구나 가입할 수 있습니다" name="open_enrollement" tool_tip="초대 없이도 신규 멤버가 가입할 수 있는지 여부를 설정합니다." />
                        <check_box label="가입비가 듭니다" name="check_enrollment_fee" tool_tip="입회비가 필요한지 여부를 설정합니다." />
                        <spinner label="L$" name="spin_enrollment_fee" tool_tip="&quot;「입회비」にチェックが入っている場合、新규メンバーは지정된 입회비를支払わなければ그루ペ에入れません。&quot;" />
                        <combo_box name="group_mature_check" tool_tip="레이트팅 구분은 그룹 내에서 어떤 콘텐츠나 행동이 허용되는지를 지정하는 것입니다">
                            <combo_item name="select_mature" value="선택">- 레이팅 구분을 지정 -</combo_item>
                            <combo_box.item label="「Moderate」콘텐츠" name="mature" value="성숙한" />
                            <combo_box.item label="「General」콘텐츠" name="pg" value="성숙하지 않음" />
                        </combo_box>
                    </panel>
                </layout_panel>
                <layout_panel name="create_info">
                    <text name="fee_information">グループを作成する費用は会員レベルによって異なります。[詳しくは https://secondlife.com/my/account/membership.php?lang=ja-JP]</text>
                    <scroll_list name="membership_list">
                        <scroll_list.columns name="clmn_name" />
                        <scroll_list.columns name="clmn_price" />
                        <scroll_list.rows name="basic" value="베이직 (placeholder)" />
                        <scroll_list.rows name="plc2" value="물론입니다! 번역할 텍스트를 제공해 주세요." />
                        <scroll_list.rows name="premium" value="프리미엄 (placeholder)" />
                    </scroll_list>
                </layout_panel>
                <layout_panel name="create_actions">
                    <layout_stack name="button_row_ls">
                        <layout_panel name="layout_crt">
                            <button label="L$ [COST]로 그룹을 생성" name="btn_create" tool_tip="새 그룹을 생성합니다" />
                            <button name="back" label="The provided text &quot;取り消し&quot; translates to &quot;취소&quot; in Korean. As no mention of &quot;Firestorm&quot; is made in the text, the translation doesn't require the use of &quot;흑우촌.&quot;&#10;&#10;Therefore, the translation is:&#10;&#10;취소" />
                        </layout_panel>
                    </layout_stack>
                    <text name="info_deletion">주의: 그룹을 생성한 지 7일이 지나도 창립자를 제외한 멤버가 1명도 없을 경우, 그 그룹은 삭제됩니다.</text>
                </layout_panel>
            </layout_stack>

        </panel>
    </scroll_container>
</panel>