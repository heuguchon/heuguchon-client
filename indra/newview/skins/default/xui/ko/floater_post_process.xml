<?xml version='1.0' encoding='utf-8'?>
<floater name="Post-Process Floater" title="포스트 프로세스 설정">
	<tab_container name="Post-Process Tabs">
		<panel label="컬러 필터" name="wmiColorFilterPanel">
			<check_box label="유효" name="wmiColorFilterToggle" />
			<text name="wmiColorFilterBrightnessText">명도</text>
			<text name="wmiColorFilterSaturationText">채도</text>
			<text name="wmiColorFilterContrastText">밝기</text>
			<text name="wmiColorFilterBaseText">輝度の基準色 -&gt; 기준 색상의 밝기</text>
			<slider label="적" name="wmiColorFilterBaseR" />
			<slider label="녹색" name="wmiColorFilterBaseG" />
			<slider label="파란색" name="wmiColorFilterBaseB" />
			<slider label="나" name="wmiColorFilterBaseI" />
		</panel>
		<panel label="나이트 비전" name="wmiNightVisionPanel">
			<check_box label="유효" name="wmiNightVisionToggle" />
			<text name="wmiNightVisionBrightMultText">광 증폭 (멀티)</text>
			<text name="wmiNightVisionNoiseSizeText">노이즈 크기</text>
			<text name="wmiNightVisionNoiseStrengthText">노이즈 강도</text>
		</panel>
		<panel label="블룸" name="wmiBloomPanel">
			<check_box label="유효함" name="wmiBloomToggle" />
			<text name="wmiBloomExtractText">명도의 추출</text>
			<text name="wmiBloomSizeText">블룸 크기</text>
			<text name="wmiBloomStrengthText">블룸 강도</text>
		</panel>
		<panel label="기타" name="Extras">
			<button label="효과 읽기" label_selected="효과 로드" name="PPLoadEffect" />
			<button label="효과 저장" label_selected="효과 저장" name="PPSaveEffect" />
			<line_editor label="효과 이름" name="PPEffectNameEditor" />
		</panel>
	</tab_container>
</floater>