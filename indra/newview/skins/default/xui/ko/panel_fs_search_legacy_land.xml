<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<panel label="토지 판매" name="panel_ls_land">
	<panel name="panel_ls_input">
		<text name="search_text">
			검색어를 입력하세요:
		</text>
		<combo_box name="land_category">
			<combo_box.item label="모든 카테고리" name="All"/>
			<combo_box.item label="경매" name="Auction"/>
			<combo_box.item label="메인랜드 판매" name="Mainland"/>
			<combo_box.item label="에스테이트 판매" name="Estate"/>
		</combo_box>
		<check_box label="가격 &lt;" name="price_check"/>
		<check_box label="크기 &gt;" name="area_check"/>
		<line_editor left_pad="30" name="edit_area"/>
		<text name="sort_text">
			정렬 기준:
		</text>
		<combo_box name="land_sort_combo">
			<combo_box.item label="이름" name="Name_item"/>
			<combo_box.item label="가격" name="Price_item"/>
			<combo_box.item label="미터당 가격" name="PPM_item"/>
			<combo_box.item label="크기" name="Area_item"/>
		</combo_box>
		<check_box label="오름차순 정렬" name="ascending_check"/>
		<button label="검색" name="land_find"/>
	</panel>
	<!-- Search Pane -->
	<panel name="panel_ls_scrolllist">
		<scroll_list name="search_results_land">
			<columns label="" name="icon"/>
			<columns label="이름" name="land_name"/>
			<columns label="가격" name="price"/>
			<columns label="크기" name="area"/>
			<columns label="L$/m" name="ppm"/>
			<columns label="유형" name="land_type"/>
		</scroll_list>
		<button label="뒤로" name="land_back"/>
		<button label="다음" name="land_next"/>
	</panel>
</panel>
