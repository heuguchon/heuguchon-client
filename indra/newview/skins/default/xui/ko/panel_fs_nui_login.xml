<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_login">
	<panel.string name="forgot_password_url">
		http://secondlife.com/account/request.php?lang=ko
	</panel.string>
	<string name="ServerComboTooltip">
		알려진 그리드 또는 그리드 URI
	</string>
	<layout_stack name="ui_stack">
		<layout_panel name="ui_container">
			<layout_stack name="vert_stack_left">
				<layout_panel name="1st_row">
					<layout_stack name="1st_row_stack">
						<layout_panel name="login">
							<combo_box name="username_combo" label="사용자명" tool_tip="등록 시 선택한 사용자명 (예: berndschmidt12 또는 Liebe Sonne)"/>
							<check_box label="사용자명 저장" name="remember_username_check"/>
						</layout_panel>
						<layout_panel name="delete_container">
							<button tool_tip="이 사용자명 삭제" name="remove_user_btn"/>
						</layout_panel>
						<layout_panel name="password_container">
							<line_editor name="password_edit" label="비밀번호"/>
							<check_box label="비밀번호 저장" name="remember_check"/>
							<button name="password_show_btn" tool_tip="비밀번호 표시"/>
							<button name="password_hide_btn" tool_tip="비밀번호 숨기기"/>
						</layout_panel>
						<layout_panel name="start_location_panel">
							<combo_box name="start_location_combo" label="여기서 시작:">
								<combo_box.item label="마지막 위치" name="MyLastLocation"/>
								<combo_box.item label="집" name="MyHome"/>
								<combo_box.item label="&lt;지역 입력&gt;" name="Typeregionname"/>
							</combo_box>
						</layout_panel>
					</layout_stack>
				</layout_panel>
				<layout_panel name="2nd_row">
					<layout_stack name="2nd_row_stack">
						<layout_panel name="grid_panel">
							<text name="grid_login_text">
								그리드:
							</text>
							<text name="grid_builder_text">
								+ 그리드 추가하려면 클릭
							</text>
						</layout_panel>
						<layout_panel name="mode_selection">
							<text name="mode_selection_text">
								모드:
							</text>
							<combo_box name="mode_combo" tool_tip="가장 익숙한 뷰어 스타일을 선택하여 기본값을 필요에 맞게 조정하세요.">
								<combo_box.item label="하이브리드" name="Hybrid"/>
								<combo_box.item label="텍스트" name="Text"/>
							</combo_box>
						</layout_panel>
					</layout_stack>
				</layout_panel>
			</layout_stack>
			<button label="로그인" name="connect_btn"/>
			<text name="create_new_account_text">
				등록
			</text>
			<text name="forgot_password_text">
				비밀번호 분실?
			</text>
		</layout_panel>
	</layout_stack>
</panel>
