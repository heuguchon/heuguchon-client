<?xml version='1.0' encoding='utf-8'?>
<panel name="panel_login">
	<panel.string name="forgot_password_url">http://secondlife.com/account/request.php?lang=ja</panel.string>
	<string name="ServerComboTooltip">기존 그리드 또는 URI</string>
	<layout_stack name="ui_stack">
		<layout_panel name="ui_elastic_pad_left" />
		<layout_panel name="ui_container">
			<icon name="sl_logo_small" />
			<layout_stack name="vert_stack_left">
				<layout_panel name="1st_row">
					<layout_stack name="1st_row_stack">
						<layout_panel name="login">
							<combo_box label="사용자 이름" tool_tip="등록 시 자신이 선택한 사용자 이름(예: bobsmith12, Steller Sunshine 등)" name="username_combo" />
							<check_box label="유저네임을 기억" name="remember_username_check" />
						</layout_panel> 
						<layout_panel name="delete_container">
							<button tool_tip="このユーザーネームを消去 -&gt; 이 사용자 이름을 삭제" label="다음 텍스트를 한국어로 번역해드리겠습니다. 텍스트가 'Firestorm'과 관련된 경우, '흑우촌'으로 번역해드리겠습니다. 원본 텍스트를 제공해주시면 작업을 시작할 수 있습니다." name="remove_user_btn" />
						</layout_panel> 
						<layout_panel name="password_container">
							
							<line_editor name="password_edit" label="비밀번호" />
							<check_box label="비밀번호 기억하기" name="remember_check" />
						</layout_panel> 
						<layout_panel name="start_location_panel">
							<combo_box label="시작 위치" name="start_location_combo">
								<combo_box.item label="마지막으로 로그아웃한 장소" name="MyLastLocation" />
								<combo_box.item label="홈" name="MyHome" />
								<combo_box.item label="＜지역명을 입력＞" name="Typeregionname" />
							</combo_box>
						</layout_panel> 
					</layout_stack> 
				</layout_panel> 

				<layout_panel name="2nd_row">
					<layout_stack name="2nd_row_stack">
						<layout_panel name="grid_panel">
							<text name="grid_login_text" width="95">그리드 선택:</text>
							<combo_box name="server_combo" />

						</layout_panel>

						<layout_panel name="mode_selection">
							<text name="mode_selection_text">모드 선택:</text>
							<combo_box tool_tip="기본 설정을 적절히 수행하기 위해, 가장 익숙한 뷰어의 타입을 선택해 주십시오." name="mode_combo">
								<combo_box.item label="흑우촌" name="Firestorm" />
								<combo_box.item label="피닉스" name="Phoenix" />
								<combo_box.item label="하이브리드" name="Hybrid" />
								<combo_box.item label="대기 시간" name="Latency" />
								<combo_box.item label="텍스트" name="Text" />
							</combo_box>
						</layout_panel>

					</layout_stack> 
				</layout_panel>  
			</layout_stack> 
			<button label="로그인" name="connect_btn" />
			<text name="create_new_account_text">アカウント作成 - 계정 생성</text>
			<text name="forgot_password_text">비밀번호를 잊으셨습니까?</text>
		</layout_panel>
		<layout_panel name="ui_elastic_pad_right" />
	</layout_stack>
</panel>