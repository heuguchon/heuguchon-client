<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater name="inventory_settings" title="인벤토리 설정">
	<text name="multi_folder_txt">
		다중 폴더 보기에서 폴더 더블클릭:
	</text>
	<radio_group name="multi_double_click_setting">
		<radio_item label="폴더 접기 &amp; 펼치기" name="0"/>
		<radio_item label="새 창으로 열기" name="1"/>
		<radio_item label="보기 전환" name="2"/>
	</radio_group>
	<text name="single_folder_txt">
		단일 폴더 보기에서 폴더 더블클릭:
	</text>
	<radio_group name="single_double_click_setting">
		<radio_item label="현재 창에서 보기" name="false"/>
		<radio_item label="새 창으로 열기" name="true"/>
	</radio_group>
	<text name="find_original_txt">
		"인벤토리에서 보기" 또는 "원본 열기":
	</text>
	<radio_group name="find_original_settings">
		<radio_item label="기본 인벤토리 창에서 보기" name="false"/>
		<radio_item label="새 단일 폴더 보기에서 표시" name="true"/>
	</radio_group>
	<button label="확인" name="ok_btn"/>
</floater>
