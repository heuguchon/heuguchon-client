<?xml version='1.0' encoding='utf-8'?>
<panel label="그룹 프로필" name="GroupInfo">
	<panel.string name="default_needs_apply_text">保存していない変更があります:

저장하지 않은 변경 사항이 있습니다.</panel.string>
	<panel.string name="want_apply_text">변경 사항을 저장하시겠습니까?</panel.string>
	<panel.string name="group_join_btn">참가 비용 (L$[AMOUNT])</panel.string>
	<panel.string name="group_join_free">무료</panel.string>

	<layout_stack name="group_info_sidetray_main">
		<layout_panel name="header_container">

	<panel name="group_info_top">
		<text_editor name="group_name" value="（가져오는 중...）" />
		<line_editor label="새로운 그룹의 이름을 입력하세요." name="group_name_editor" />
	</panel>

		</layout_panel>
		<layout_panel name="group_info_content">

	<layout_stack name="layout">
		<layout_panel name="group_accordions">
			<accordion name="groups_accordion">
				<accordion_tab name="group_general_tab" title="일반" />
				<accordion_tab name="group_roles_tab" title="역할" />
				<accordion_tab name="group_notices_tab" title="알림" />
				<accordion_tab name="group_land_tab" title="토지 및 자산" />
				<accordion_tab name="group_experiences_tab" title="체험" />
			</accordion>
		</layout_panel>
	</layout_stack>
	<layout_stack name="button_row_ls">
		<layout_panel name="btn_chat_lp">
			<button label="채팅" name="btn_chat" />
		</layout_panel>
		<layout_panel name="call_btn_lp">
			<button label="그룹 통화" name="btn_call" tool_tip="このグループにコールする" />
		</layout_panel>
		<layout_panel name="btn_apply_lp">
			<button label="저장" label_selected="저장" name="btn_apply" />
			<button label="グループを作成 -&gt; 그룹 생성" name="btn_create" tool_tip="새 그룹 만들기" />
		</layout_panel>
	</layout_stack>

		</layout_panel>
	</layout_stack>
</panel>