<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel label="하드웨어/인터넷" name="Input panel">
	<tab_container name="tabs">
		<panel label="연결" name="tab-conn">
			<text name="Maximum bandwidth">
				최대 대역폭 ([https://wiki.firestormviewer.org/fs_speedtest 권장사항 보기?]):
			</text>
			<text name="NetworkPrefText1">
				무선
			</text>
			<text name="NetworkPrefText2">
				DSL
			</text>
			<text name="NetworkPrefText3">
				케이블
			</text>
			<text name="NetworkPrefText4">
				문제를 일으킬 수 있음
			</text>
			<check_box label="사용자 지정 포트" name="connection_port_enabled"/>
			<spinner label="포트 번호:" name="connection_port" width="155" label_width="80"/>
			<text name="Web:">
				웹 브라우저:
			</text>
			<radio_group name="preferred_browser_behavior">
				<radio_item label="모든 링크에 기본 시스템 브라우저 사용" name="new_external" tool_tip="도움말, 웹 링크 등에 기본 브라우저 사용. 전체 화면 모드에서는 권장하지 않음."/>
				<radio_item label="Second Life 링크에만 내장 브라우저 사용" name="new_internal" tool_tip="도움말, 웹 링크 등을 보기 위해 내장 웹 브라우저 사용. 이 브라우저는 [APP_NAME] 내에서 새 창으로 열립니다."/>
				<radio_item label="모든 링크에 내장 브라우저 사용" name="new_internal_all" tool_tip="도움말, 웹 링크 등을 보기 위해 내장 웹 브라우저 사용. 이 브라우저는 [APP_NAME] 내에서 새 창으로 열립니다."/>
			</radio_group>
			<text name="numberwebfloaters_label">
				최대 웹 브라우저 창 수:
			</text>
			<combo_box tool_tip="동시에 열 수 있는 웹 브라우저 창의 최대 개수." name="web_number_combobox">
				<combo_box.item label="무제한" name="web_unlimited"/>
				<combo_box.item label="1개 창" name="web_1"/>
				<combo_box.item label="5개 창" name="web_5"/>
				<combo_box.item label="10개 창" name="web_10"/>
			</combo_box>
			<button label="웹 브라우저 캐시 지우기" name="ClearWebBrowserCache" width="160"/>
			<check_box label="Javascript 활성화" name="browser_javascript_enabled"/>
			<check_box label="미디어 브라우저 팝업 활성화" name="media_popup_enabled"/>
			<button label="프록시 설정 변경" label_selected="프록시 설정 변경" name="set_proxy"/>
			<text name="home_page_label_l">
				브라우저 홈페이지:
			</text>
		</panel>
		<panel label="디렉토리" name="tab-dir">
			<text name="cache_size_label_l">
				텍스처 캐시 크기 ([https://wiki.firestormviewer.org/cache 권장사항 보기?]):
			</text>
			<text name="asset_cache_size_label_l">
				에셋 캐시 크기:
			</text>
			<button label="인벤토리 캐시 지우기" width="137" name="ClearInventoryCache"/>
			<text name="Cache location">
				캐시 저장 위치:
			</text>
			<button label="열기" label_selected="열기" name="open_cache"/>
			<button label="설정" label_selected="설정" name="set_cache" width="45"/>
			<button label="초기화" label_selected="초기화" name="reset_cache" width="82"/>
			<button label="삭제" label_selected="삭제" name="clear_cache" width="53" left_pad="5"/>
			<text name="Sound Cache location">
				사운드 캐시 저장 위치:
			</text>
			<button label="열기" label_selected="열기" name="open_sound_cache"/>
			<button label="설정" label_selected="설정" name="set_sound_cache" width="45"/>
			<button label="초기화" label_selected="초기화" name="reset_sound_cache" width="82"/>
			<check_box label="로그아웃 시 DSF(사운드) 캐시 파일 삭제하지 않음" tool_tip="활성화하면 로그아웃 시 압축 해제된 사운드 파일이 캐시에서 삭제되지 않아 사운드 재생 성능이 향상될 수 있습니다. 주의: 캐시 크기가 매우 빠르게 증가할 수 있으며 캐시 크기 제한이 무시되어 10GB 이상의 디스크 공간을 사용할 수 있습니다! 이 옵션은 Firestorm에서 기본적으로 비활성화됩니다." name="keep_unpacked_cache"/>
			<text name="log_path_desc">
				채팅 로그 및 기록 저장 위치:
			</text>
			<button label="열기" label_selected="열기" name="open_log_path_button-panelsetup"/>
			<button label="설정" label_selected="설정" name="log_path_button-panelsetup" width="45"/>
			<button label="초기화" label_selected="초기화" name="reset_logpath" width="82"/>
			<button label="뷰어 로그 열기" label_selected="뷰어 로그 열기" name="browse_crashlogs" width="140"/>
			<button label="설정 폴더 열기" label_selected="설정 폴더 열기" name="browse_settingsdir" width="190"/>
		</panel>
	</tab_container>
</panel>
