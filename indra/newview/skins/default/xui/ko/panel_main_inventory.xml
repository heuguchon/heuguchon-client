<?xml version='1.0' encoding='utf-8'?>
<panel label="もの" name="main inventory panel">
	<panel.string name="ItemcountFetching">[ITEM_COUNT] 개의 아이템을 가져오는 중입니다... [FILTER]</panel.string>
	<panel.string name="ItemcountCompleted">[ITEM_COUNT] 개 아이템 [FILTER]</panel.string>
	<layout_stack name="top_stack">
		<layout_panel name="filter_panel">
			<filter_editor label="인벤토리를 필터링" name="inventory search editor" tool_tip="１つ以上の 단어를 입력하여 검색합니다. 두 개 이상의 단어를 입력할 때는 &quot;+&quot;로 연결합니다." />
		</layout_panel>
	</layout_stack>
	<layout_stack name="ctrl_stack">
		<layout_panel name="collapse_expand_buttons">
			<button name="collapse_btn" label="접는 중" />
			<button name="expand_btn" label="확장" />
		</layout_panel>
		<layout_panel name="filter_ctrls">
			<text name="filter_label" value="필터:" />
			<combo_box name="filter_combo_box">
				<combo_box.item value="필터_유형_모두" label="모든 종류" />
				<combo_box.item value="애니메이션 필터 유형" label="애니메이션" />
				<combo_box.item value="필터_타입_ 호출_카드" label="Calling Card: 코링 카드" />
				<combo_box.item value="필터_타입_의류" label="복장/신체 부위" />
				<combo_box.item value="필터_유형_제스처" label="제스처" />
				<combo_box.item value="필터_유형_랜드마크" label="랜드마크" />
				<combo_box.item value="필터_타입_노트카드" label="노트 카드" />
				<combo_box.item value="필터_유형_객체" label="객체" />
				<combo_box.item value="필터_유형_스크립트" label="스크립트" />
				<combo_box.item value="필터_유형_소리" label="사운드" />
				<combo_box.item value="텍스처_필터_유형" label="텍스처" />
				<combo_box.item value="필터_종류_스냅샷" label="스냅샷" />
				<combo_box.item value="필터 유형 설정" label="자연환경설정" />
				<combo_box.item value="필터_타입_사용자정의" label="カスタマイズ... (Customize...)" />
			</combo_box>
			<menu_button tool_tip="可視性オプション을 표시" name="options_visibility_btn" />
		</layout_panel>
	</layout_stack>
	<panel name="default_inventory_panel">
		<tab_container name="inventory filter tabs">
			<inventory_panel label="인벤토리" name="All Items" />
			<recent_inventory_panel label="최신" name="Recent Items" />
			<worn_inventory_panel label="장착 중" name="Worn Items" />
		</tab_container>
	</panel>
	<panel name="bottom_panel">
		<panel name="options_gear_btn_panel">
			<menu_button name="options_gear_btn" tool_tip="옵션을 표시합니다" />
		</panel>
		<panel name="add_btn_panel">
			<button name="add_btn" tool_tip="새로운 아이템을 추가합니다" />
		</panel>
		<panel name="new_inventory_panel">
			<button name="new_inv_btn" tool_tip="다른 인벤토리 창" />
		</panel>
		<panel name="dummy_panel">
			<text name="ItemcountText" tool_tip="[CATEGORIES] 폴더에 [ITEMS] 아이템이 있습니다">요소</text>
		</panel>
		<panel name="trash_btn_panel">
			<dnd_button name="trash_btn" tool_tip="선택한 아이템을 삭제합니다" />
		</panel>
	</panel>
</panel>