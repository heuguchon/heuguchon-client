<?xml version='1.0' encoding='utf-8'?>
<floater name="camera_floater" title="카메라의 컨트롤">
	<floater.string name="rotate_tooltip">포커스를 중심으로 카메라를 회전</floater.string>
	<floater.string name="zoom_tooltip">포커스에 맞춰 카메라를 줌</floater.string>
	<floater.string name="move_tooltip">카메라를 상하좌우로 이동</floater.string>
	<floater.string name="free_mode_title">오브젝트 보기</floater.string>
	<string name="inactive_combo_text">프리셋 사용</string>
	<panel name="buttons_panel">
		<panel_camera_item name="front_view" tool_tip="전방 시야" />
		<panel_camera_item name="group_view" tool_tip="측면 시야" />
		<panel_camera_item name="rear_view" tool_tip="후방 시야" />
		<panel_camera_item name="object_view" tool_tip="오브젝트 시점" />
		<panel_camera_item name="mouselook_view" tool_tip="일인칭 시점" />
		<panel_camera_item name="reset_view" tool_tip="리셋" />
	</panel>
	<panel name="zoom">
		<layout_stack name="camera_view_layout_stack">
			<layout_panel name="camera_rotate_layout_panel">
				<joystick_rotate name="cam_rotate_stick" tool_tip="자신을 중심으로 카메라를 회전시키다" />
			</layout_panel>
			<layout_panel name="camera_zoom_layout_panel">
				<slider_bar name="zoom_slider" tool_tip="보고 있는 방향으로 카메라를 줌イン" />
			</layout_panel>
			<layout_panel name="panel_track">
				<joystick_track name="cam_track_stick" tool_tip="카메라를 위아래 좌우로 움직입니다." />
			</layout_panel>
		</layout_stack>
	</panel>
	<panel name="preset_buttons_panel">
		<button label="카메라 위치..." name="camera_position_btn" />
		<button name="save_preset_btn" tool_tip="프리셋으로 저장" />
		<combo_box name="preset_combo">
			<combo_box.item label="프리셋 사용" name="Use preset" />
		</combo_box>
		<button name="gear_btn" tool_tip="카메라 프리셋" />
	</panel>
</floater>