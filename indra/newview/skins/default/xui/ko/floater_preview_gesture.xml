	</text>
	<check_box label="활성" name="active_check" tool_tip="활성 제스처는 채팅에서 트리거 문구를 입력하거나 단축키를 눌러 실행됩니다. 중복 키 할당이 있을 경우 제스처가 일반적으로 작동하지 않습니다."/>
	<button label="미리보기" name="preview_btn"/>
	<button label="저장" name="save_btn"/>
