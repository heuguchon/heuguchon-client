		<scroll_list.rows name="action_animation" value="애니메이션"/>
		<scroll_list.rows name="action_sound" value="사운드"/>
		<scroll_list.rows name="action_chat" value="채팅"/>
		<scroll_list.rows name="action_wait" value="대기"/>
	</scroll_list>
