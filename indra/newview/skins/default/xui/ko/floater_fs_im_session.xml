<?xml version='1.0' encoding='utf-8'?>
<floater name="panel_im">
	<floater.string name="participant_added" value="[NAME] がこの会話に招待されました。 &#10;[NAME] 이 대화에 초대되었습니다." />
	<floater.string name="multiple_participants_added" value="[NAME] がこの会話に招待されました。" />
	<layout_stack orientation="horizontal" name="ls_control_panel">
		<layout_panel name="slide_panel">
			<button name="slide_left_btn" />
			<button name="slide_right_btn" />
		</layout_panel>
       
       <layout_panel name="gprofile_panel">
			<button name="group_info_btn" tool_tip="이 그룹의 프로필을 표시합니다." />
       </layout_panel>
       
       <layout_panel name="profile_panel">	  
       		<button name="view_profile_btn" tool_tip="この 주민의 프로필을 표시합니다." />
       </layout_panel>

       <layout_panel name="friend_panel">
        	<button tool_tip="이 거주자에게 친구 요청을 보냅니다." name="add_friend_btn" />
       </layout_panel>
       
		<layout_panel name="tp_panel">
			<menu_button name="teleport_btn" tool_tip="이 주민에게 텔레포트를 보내서 부르거나 텔레포트를 요구해서 불러달라고 합니다." />
		</layout_panel>
       
       <layout_panel name="share_panel">
			<button tool_tip="이 거주자에게 아이템을 보냅니다." name="share_btn" />
       </layout_panel>
       
       <layout_panel name="pay_panel">
        	<button tool_tip="이 거주자에게 린덴 달러를 송금합니다." name="pay_btn" />
       </layout_panel>

       <layout_panel name="call_btn_panel">              
         	<button tool_tip="このチャットにボイスを追加します。&#10;&#10;이 채팅에 음성을 추가합니다" name="call_btn" />
       </layout_panel> 
       
       <layout_panel name="end_call_btn_panel">       
         	<button tool_tip="보이스콜을 종료합니다." name="end_call_btn" />
       </layout_panel>
       
       <layout_panel name="voice_ctrls_btn_panel">             
			<button tool_tip="보이스 컨트롤" name="voice_ctrls_btn" />
       </layout_panel>
      
       <layout_panel name="im_history_btn_panel">             
			<button tool_tip="このIMの会話履歴を開きます。  &#10;IM 대화 기록을 엽니다." name="im_history_btn" />
        </layout_panel>
	
	<layout_panel name="add_participant_panel">
		<button tool_tip="대화에 사람을 추가합니다." name="add_participant_btn" />
	</layout_panel>
      
       <layout_panel name="send_sysinfo_btn_panel">             
			<button tool_tip="시스템 정보를 보냅니다." name="send_sysinfo_btn" />
        </layout_panel>

	<layout_panel name="lp_options_btn">
		<menu_button tool_tip="채팅 옵션" name="chat_options_btn" />
	</layout_panel>
	<layout_panel name="lp_chat_search_btn">
		<button name="chat_search_btn" tool_tip="채팅을 검색합니다" />
	</layout_panel>
      
		<layout_panel name="support_panel" width="130">             
			<icon name="dummy_icon_support_group" width="128" />
			<check_box label="뷰어 유형을 특정" name="FSSupportGroupChatPrefix_toggle" width="125" tool_tip="당신이 현재 사용 중인 뷰어의 버전과 스킨 정보를 이 그룹에 보내는 메시지의 맨 앞에 추가하세요. 그렇게 하면, 지원 직원이 당신에게 발생한 문제를 정확하게 진단하고, 당신의 질문에 대해 보다 정확한 답변을 제공할 수 있습니다." />
		</layout_panel>
		<layout_panel name="testing_panel">
			<check_box label="ビルドを指定&#10;&#10;빌드를 지정" name="FSSupportGroupChatPrefixTesting_toggle" tool_tip="현재의 뷰어 버전, 뷰어 스킨, OS, RLVa의 상태를 이 그룹에 보내는 메시지의 시작 부분에 추가하여 지원 직원이 문제를 정확하게 진단하고 문의에 정확하게 답변할 수 있도록 돕습니다. (이 메시지는 지원 그룹에 직접 발송되는 것은 아닙니다.)" />
		</layout_panel>
		<layout_panel name="lp_bar">
			<icon name="dummy_icon" />
		</layout_panel>
	</layout_stack>
	<layout_stack orientation="horizontal" name="chat_stack">
		<layout_panel name="im_control_panel_holder">
			<panel name="panel_im_control_panel" />
		</layout_panel>
		<layout_panel name="panel_im_control_lp">
			<layout_stack orientation="vertical" name="im_panels">
				<layout_panel name="chat_holder">
					<fs_chat_history name="chat_history" />
				</layout_panel>
				<layout_panel name="unread_messages_holder">
					<icon name="unread_messages_background" />
					<text name="unread_messages_text">미독 메시지: [NUM]</text>
				</layout_panel>
				<layout_panel name="chat_layout_panel">
					<layout_stack orientation="horizontal" name="input_panels">
						<layout_panel name="input_editor_layout_panel">
							<chat_editor name="chat_editor" />
						</layout_panel>
						<layout_panel name="input_button_layout_panel">
							<button name="send_chat" label="전송" tool_tip="IM을 보냅니다" />
						</layout_panel>
					</layout_stack>
				</layout_panel>
			</layout_stack>
		</layout_panel>
	</layout_stack>
</floater>