<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_experience_log" label="이벤트">
	<string name="no_events" value="이벤트가 없습니다."/>
	<string name="loading" value="로딩 중..."/>
	<layout_stack name="ls1">
		<layout_panel name="list panel">
			<scroll_list name="experience_log_list">
				<columns label="시간" name="time"/>
				<columns label="이벤트" name="event"/>
				<columns label="경험" name="experience_name"/>
				<columns label="객체" name="object_name"/>
			</scroll_list>
			<button label="알림" name="btn_notify"/>
			<button label="프로필" name="btn_profile_xp"/>
			<button label="신고" name="btn_report_xp"/>
		</layout_panel>
		<layout_panel name="button_panel">
			<check_box label="모든 이벤트 알림   일" name="notify_all" width="205"/>
			<button label="삭제" name="btn_clear"/>
			<button label="&lt;" name="btn_prev"/>
			<button label="&gt;" name="btn_next"/>
		</layout_panel>
	</layout_stack>
</panel>
