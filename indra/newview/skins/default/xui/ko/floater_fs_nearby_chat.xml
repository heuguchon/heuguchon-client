<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater name="nearby_chat" title="근처 채팅">
	<floater.string name="chatbox_label">
		근처 채팅에게
	</floater.string>
	<layout_stack name="ls_control_panel">
		<layout_panel name="lp_chat_history_btn">
			<button name="chat_history_btn" tool_tip="근처 채팅 기록 열기"/>
		</layout_panel>
		<layout_panel name="lp_chat_history_muted_btn">
			<button name="chat_history_muted_btn" tool_tip="근처 채팅에서 차단된 채팅 보기"/>
		</layout_panel>
		<layout_panel name="lp_options_btn">
			<button name="chat_options_btn" tool_tip="채팅 옵션"/>
		</layout_panel>
		<layout_panel name="lp_chat_search_btn">
			<button name="chat_search_btn" tool_tip="근처 채팅 검색"/>
		</layout_panel>
	</layout_stack>
	<layout_stack name="ls_chat">
		<layout_panel name="panel_im_control_lp">
			<layout_stack name="im_panels">
				<layout_panel name="unread_messages_holder">
					<text name="unread_messages_text">
						읽지 않은 메시지: [NUM]
					</text>
				</layout_panel>
				<layout_panel name="chat_layout_panel">
					<layout_stack name="input_panels">
						<layout_panel name="input_editor_layout_panel">
							<chat_editor name="chat_box"/>
						</layout_panel>
						<layout_panel name="emoji_button_layout_panel">
							<button name="emoji_picker_toggle_btn" tool_tip="이모지 선택기 열기"/>
							<button name="emoji_recent_panel_toggle_btn" tool_tip="최근 사용한 이모지 선택기 열기/닫기"/>
						</layout_panel>
						<layout_panel name="input_button_layout_panel">
							<spinner name="ChatChannel" tool_tip="채팅을 보낼 채널. 환경설정 -> 채팅 -> Firestorm -> 입력줄에 채널 선택 표시에서 활성화할 수 있습니다." label_width="35"/>
						</layout_panel>
						<layout_panel name="chat_type_layout_panel">
							<combo_box name="chat_type" tool_tip="속삭임 = 10m, 말하기 = 20m, 외치기 = 100m">
								<combo_box.item name="chat_type_whisper" label="속삭임"/>
								<combo_box.item name="chat_type_say" label="말하기"/>
								<combo_box.item name="chat_type_shout" label="외치기"/>
							</combo_box>
							<button label="보내기" name="send_chat" tool_tip="속삭임 = 10m, 말하기 = 20m, 외치기 = 100m"/>
						</layout_panel>
					</layout_stack>
				</layout_panel>
				<layout_panel name="emoji_recent_layout_panel">
					<text name="emoji_recent_empty_text">
						최근 사용한 이모지가 여기에 나타납니다
					</text>
				</layout_panel>
			</layout_stack>
		</layout_panel>
	</layout_stack>
</floater>