<?xml version='1.0' encoding='utf-8'?>
<floater name="nearby_chat" title="주변 채팅">
<floater.string name="chatbox_label">주변 채팅에</floater.string>

<layout_stack name="ls_control_panel">

    <layout_panel name="lp_chat_history_btn">
		<button tool_tip="주변 채팅 기록을 엽니다." name="chat_history_btn" />
	</layout_panel>
    <layout_panel name="lp_chat_history_muted_btn">
		<button tool_tip="주변 채팅 기록에 무시한 대화를 표시합니다." name="chat_history_muted_btn" />
	</layout_panel>
	<layout_panel name="lp_options_btn">
		<menu_button tool_tip="채팅 옵션" name="chat_options_btn" />
	</layout_panel>
	<layout_panel name="lp_chat_search_btn">
		<button name="chat_search_btn" tool_tip="주변 채팅 검색" />
	</layout_panel>
	
</layout_stack>
  
<layout_stack name="ls_chat">

	<layout_panel name="panel_im_control_lp">
		<layout_stack name="im_panels">
			<layout_panel name="chat_holder">
				<fs_chat_history name="chat_history" />
				<fs_chat_history name="chat_history_muted" />
			</layout_panel>
			<layout_panel name="chat_layout_panel">
				<layout_stack name="input_panels">
					<layout_panel name="input_editor_layout_panel">
						<chat_editor name="chat_box" />
					</layout_panel>
					<layout_panel name="input_button_layout_panel">
						<spinner label="Sure, please provide the text you would like to translate." name="ChatChannel" tool_tip="채팅을 표시할 채널을 선택합니다. 환경 설정 &gt; 채팅 &gt; 흑우촌 &gt; '채팅 바에 채널 선택을 표시'에서 설정합니다." />
					</layout_panel>
				</layout_stack>

			</layout_panel>
		</layout_stack>
	</layout_panel>
	
</layout_stack>

</floater>