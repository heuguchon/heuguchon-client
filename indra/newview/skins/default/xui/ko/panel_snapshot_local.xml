<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_snapshot_local">
	<text name="title">
		디스크
	</text>
	<combo_box label="해상도" name="local_size_combo">
		<combo_box.item label="현재 창" name="CurrentWindow"/>
		<combo_box.item label="320x240" name="320x240"/>
		<combo_box.item label="640x480" name="640x480"/>
		<combo_box.item label="800x600" name="800x600"/>
		<combo_box.item label="1024x768" name="1024x768"/>
		<combo_box.item label="1280x1024" name="1280x1024"/>
		<combo_box.item label="1600x1200" name="1600x1200"/>
		<combo_box.item label="사용자 지정" name="Custom"/>
	</combo_box>
	<spinner label="너비 x 높이" name="local_snapshot_width"/>
	<check_box label="화면 비율 유지" name="local_keep_aspect_check"/>
	<text name="local_format_label">
		형식:
	</text>
	<combo_box label="형식" name="local_format_combo">
		<combo_box.item label="PNG (무손실)" name="PNG"/>
		<combo_box.item label="JPEG" name="JPEG"/>
		<combo_box.item label="BMP (무손실)" name="BMP"/>
	</combo_box>
	<slider label="품질:" name="image_quality_slider"/>
	<check_box name="local_remember_location_sessions" label="위치와 파일명 기억"/>
	<check_box name="local_use_timestamp" label="파일명에 날짜/시간 사용"/>
	<button label="&#x25B6; 선택" name="cancel_btn"/>
	<flyout_button label="저장" name="save_btn" tool_tip="이미지를 파일로 저장">
		<flyout_button.item label="저장" name="save_item"/>
		<flyout_button.item label="다른 이름으로 저장..." name="saveas_item"/>
	</flyout_button>
</panel>
