<?xml version='1.0' encoding='utf-8'?>
<panel name="panel_login">
	<panel.string name="forgot_password_url">http://secondlife.com/account/request.php?lang=ja</panel.string>
	<panel.string name="sign_up_url">https://www.흑우촌viewer.org/join-secondlife/</panel.string>
	<layout_stack name="ui_stack">
		<layout_panel name="ui_container">
			<combo_box label="사용자 이름" name="username_combo" tool_tip="사용자가 등록 시에 스스로 선택한 사용자 이름(예: bobsmith12, Steller Sunshine 등)" />
			<line_editor label="パスワード -&gt; 비밀번호" name="password_edit" />
			<combo_box label="お気に入りの場所 -&gt; 즐겨찾는 장소" name="start_location_combo">
				<combo_box.item label="마지막으로 로그아웃한 위치" name="MyLastLocation" />
				<combo_box.item label="홈" name="MyHome" />
			</combo_box>
			<button label="로그인" name="connect_btn" />
			<check_box label="기억하기" name="remember_check" />
			<text name="forgot_password_text">비밀번호를 잊어버린 경우</text>
			<combo_box label="그리드를 선택" name="server_combo" />
			<text name="sign_up_text">등록</text>
		</layout_panel>
	</layout_stack>
</panel>