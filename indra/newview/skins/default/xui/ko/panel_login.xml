<?xml version="1.0" encoding="utf-8"?>
<panel name="panel_login">
	<panel.string name="forgot_password_url">
		http://secondlife.com/account/request.php?lang=ko
	</panel.string>
	<panel.string name="sign_up_url">
		https://www.firestormviewer.org/join-secondlife/
	</panel.string>
	<layout_stack name="ui_stack">
		<layout_panel name="ui_container">
			<combo_box label="사용자명" name="username_combo" tool_tip="등록 시 선택한 사용자명 (예: &quot;홍길동12&quot; 또는 &quot;사랑 희망&quot;)"/>
			<line_editor label="비밀번호" name="password_edit"/>
			<combo_box label="즐겨찾는 장소" name="start_location_combo">
				<combo_box.item label="마지막 위치" name="MyLastLocation"/>
				<combo_box.item label="내 집" name="MyHome"/>
			</combo_box>
			<button label="로그인" name="connect_btn"/>
			<check_box label="정보 저장" name="remember_check"/>
			<text name="forgot_password_text">
				비밀번호 찾기
			</text>
			<combo_box label="그리드 선택" name="server_combo"/>
			<text name="sign_up_text">
				회원가입
			</text>
		</layout_panel>
	</layout_stack>
</panel>
