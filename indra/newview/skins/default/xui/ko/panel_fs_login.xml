<?xml version='1.0' encoding='utf-8'?>
<panel name="panel_login">
	<panel.string name="forgot_password_url">http://secondlife.com/account/request.php?lang=ja</panel.string>
	<string name="ServerComboTooltip">기존의 그리드 또는 URI</string>
	<layout_stack name="login_widgets">
		<layout_panel name="login">
			<text name="log_in_text">로그인</text>
			<text name="username_text">사용자 이름：</text>
			<combo_box name="username_combo" tool_tip="자신이 선택한 사용자 이름으로 등록 (예: bobsmith12, Steller Sunshine 등)" />
			<button label="입력 내용을 소거" name="delete_saved_login_btn" />
			<text name="password_text">비밀번호:</text>
		</layout_panel>
		<layout_panel name="start_location_panel">
			<text name="start_location_text">시작 지점:</text>
			<combo_box name="start_location_combo">
				<combo_box.item label="마지막으로 로그아웃 한 장소" name="MyLastLocation" />
				<combo_box.item label="홈" name="MyHome" />
				<combo_box.item label="＜지역명을 입력＞" name="Typeregionname" />
			</combo_box>
		</layout_panel>
		<layout_panel name="grid_panel">
			<text name="grid_login_text">그리드 선택:</text>
			<combo_box name="server_combo" />
		</layout_panel>
		<layout_panel name="links_login_panel">
			<text name="create_new_account_text">アカウント作成 - 계정 만들기</text>
			<text name="forgot_password_text">사용자 이름 또는 비밀번호를 잊으셨습니까?</text>
			<button label="로그인" name="connect_btn" />
			<check_box label="ユーザーネームを記憶 - 사용자 이름 기억" name="remember_username_check" />
			<check_box label="パスワードを記憶 -&gt; 비밀번호 기억하기&#10;&#10;(Note: The text provided is translated as &quot;Remember Password&quot; in Korean in the context of SecondLife Viewer.)" name="remember_check" />
		</layout_panel>
		<layout_panel name="mode_selection">
			<text name="mode_selection_text">모드 선택</text>
			<combo_box tool_tip="기본 설정을 적절히 수행하려면 가장 익숙한 뷰어 유형을 선택하십시오." name="mode_combo">
				<combo_box.item label="흑우촌" name="Firestorm" />
				<combo_box.item label="피닉스" name="Phoenix" />
				<combo_box.item label="하이브리드" name="Hybrid" />
				<combo_box.item label="지연 시간" name="Latency" />
			</combo_box>
		</layout_panel>
	</layout_stack>
</panel>