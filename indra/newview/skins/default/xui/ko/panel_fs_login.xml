<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_login">
	<panel.string name="create_account_url">
		http://ko.secondlife.com/registration/
	</panel.string>
	<panel.string name="forgot_password_url">
		http://secondlife.com/account/request.php?lang=ko
	</panel.string>
	<string name="ServerComboTooltip">
		알려진 그리드 또는 그리드 URI
	</string>
	<layout_stack name="login_widgets">
		<layout_panel name="login">
			<text name="log_in_text">
				로그인
			</text>
			<text name="username_text">
				사용자명:
			</text>
			<combo_box name="username_combo" tool_tip="등록할 때 선택한 사용자명 (예: 'bobsmith12' 또는 'Steller Sunshine')"/>
			<button tool_tip="이 사용자명을 삭제합니다" name="remove_user_btn"/>
			<text name="password_text">
				비밀번호:
			</text>
		</layout_panel>
		<layout_panel name="start_location_panel">
			<text name="start_location_text">
				시작 위치:
			</text>
			<combo_box name="start_location_combo">
				<combo_box.item label="마지막 위치" name="MyLastLocation"/>
				<combo_box.item label="집" name="MyHome"/>
				<combo_box.item label="&lt;지역명 입력&gt;" name="Typeregionname"/>
			</combo_box>
		</layout_panel>
		<layout_panel name="grid_panel">
			<text name="grid_builder_text">
				+ 클릭하여 그리드 추가
			</text>
			<text name="grid_login_text">
				그리드 선택:
			</text>
		</layout_panel>
		<layout_panel name="links_login_panel">
			<text name="create_new_account_text">
				가입하기
			</text>
			<text name="forgot_password_text">
				사용자명이나 비밀번호를 잊으셨나요?
			</text>
			<button label="로그인" name="connect_btn"/>
			<check_box label="사용자명 기억" name="remember_username_check"/>
			<check_box label="비밀번호 기억" name="remember_check"/>
			<button name="password_show_btn" tool_tip="비밀번호 표시"/>
			<button name="password_hide_btn" tool_tip="비밀번호 숨기기"/>
		</layout_panel>
		<layout_panel name="mode_selection">
			<text name="mode_selection_text">
				모드 선택
			</text>
			<combo_box name="mode_combo" tool_tip="가장 익숙한 뷰어 스타일을 선택하여 기본값을 필요에 맞게 조정하세요.">
				<combo_box.item label="하이브리드" name="Hybrid"/>
				<combo_box.item label="텍스트" name="Text"/>
			</combo_box>
		</layout_panel>
	</layout_stack>
</panel>
