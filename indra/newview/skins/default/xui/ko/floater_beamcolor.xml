<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater name="BeamColor" title="선택 빔 색상 회전">
	<floater.string name="start_hue">
		시작 색상
	</floater.string>
	<floater.string name="end_hue">
		끝 색상
	</floater.string>
	<text name="beamcolor_text">
마우스로 회전이 시작되거나 멈출 색상을
선택해주세요.
왼쪽 클릭으로 시작 색상을 변경합니다.
오른쪽 클릭으로 끝 색상을 변경합니다.
	</text>
	<color_swatch name="BeamColor_Preview" tool_tip="클릭하여 색상 선택기 열기"/>
	<text name="beamcolor_text2">
		미리보기
	</text>
	<slider name="BeamColor_Speed" label_width="100" label="속도" tool_tip="색상 회전 속도를 제어합니다"/>
	<button label="저장" name="BeamColor_Save"/>
	<button label="로드" name="BeamColor_Load"/>
	<button label="취소" name="BeamColor_Cancel"/>
</floater>
