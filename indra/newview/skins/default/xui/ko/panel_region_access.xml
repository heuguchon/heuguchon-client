<?xml version='1.0' encoding='utf-8'?>
<panel label="접속" name="Access">
	<tab_container name="tabs">
		<panel label="부동산 매니저" name="estate_managers_panel">
			<text name="estate_manager_label">부동산 매니저:</text>
			<name_list name="estate_manager_name_list">
				<columns label="名前" name="name" />
			</name_list>
			<button label="추가…" name="add_estate_manager_btn" />
			<button label="삭제…" name="remove_estate_manager_btn" />
		</panel>
		<panel label="허가" name="allowed_panel">
			<panel label="탑 패널" name="allowed_search_panel">
				<filter_editor label="허가된 에이전트를 검색" name="allowed_search_input" />
				<button label="복사" name="copy_allowed_list_btn" />
			</panel>
			<text name="allow_resident_label">항상 허용:</text>
			<name_list name="allowed_avatar_name_list">
				<columns label="이름" name="name" />
			</name_list>
			<button label="추가..." name="add_allowed_avatar_btn" />
			<button label="삭제…" name="remove_allowed_avatar_btn" />
		</panel>
		<panel label="허가된 그룹" name="allowed_groups_panel">
			<panel label="탑_패널" name="allowed_group_search_panel">
				<filter_editor label="허가된 그룹을 검색" name="allowed_group_search_input" />
				<button label="복사" name="copy_allowed_group_list_btn" />
			</panel>
			<text name="allow_group_label">항상 승인된 그룹:</text>
			<name_list name="allowed_group_name_list">
				<columns label="이름" name="name" />
			</name_list>
			<button label="추가..." name="add_allowed_group_btn" />
			<button label="삭제…" name="remove_allowed_group_btn" />
		</panel>
		<panel label="금지" name="banned_panel">
			<panel label="상단 패널" name="banned_search_panel">
				<filter_editor label="금지된 에이전트를 검색" name="banned_search_input" />
				<button label="복사" name="copy_banned_list_btn" />
			</panel>
			<text name="ban_resident_label">항상 밴:</text>
			<name_list name="banned_avatar_name_list">
				<columns label="이름" name="name" />
				<columns label="마지막으로 로그인한 날" name="last_login_date" />
				<columns label="밴 당한 날짜" name="ban_date" />
				<columns label="차단한 사람:" name="bannedby" />
			</name_list>
			<button label="추가…" name="add_banned_avatar_btn" />
			<button label="삭제..." name="remove_banned_avatar_btn" />
		</panel>
	</tab_container>
</panel>