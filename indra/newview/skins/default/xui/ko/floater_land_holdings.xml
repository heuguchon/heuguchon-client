<?xml version='1.0' encoding='utf-8'?>
<floater name="land holdings floater" title="자신의 토지">
	<scroll_list name="parcel list">
		<column label="구획" name="name" />
		<column label="리전 (지역)" name="location" />
		<column label="종류" name="type" />
		<column label="면적" name="area" />
		<column label="Sure, please provide the text that you would like to have translated." name="hidden" />
	</scroll_list>
	<button label="텔레포트" label_selected="텔레포트" name="Teleport" tool_tip="이 땅의 중심으로 텔레포트합니다." />
	<button label="지도" label_selected="지도" name="Show on Map" tool_tip="이 땅을 월드 맵에 표시합니다." />
	<text name="contrib_label">그룹 기여도:</text>
	<scroll_list name="grant list">
		<column label="그룹명" name="group" />
		<column label="면적" name="area" />
	</scroll_list>
	<text name="allowed_label">현재의 지불 계획으로 이용 가능한 입주지:</text>
	<text name="allowed_text">[AREA]㎡</text>
	<text name="current_label">현재 보유한 토지:</text>
	<text name="current_text">[AREA]㎡</text>
	<text name="available_label">구매 가능한 토지:</text>
	<text name="available_text">[AREA]㎡</text>
	<string name="area_string">[면적]㎡</string>
</floater>