<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="area_search" title="객체 지역 검색">
	<tab_container name="area_searchtab">
		<panel name="area_search_list_panel" label="목록">
			<panel.string name="ListedPendingTotalBlank">
				목록 | 대기 중 | 총계
			</panel.string>
			<panel.string name="ListedPendingTotalFilled">
				[LISTED] 목록 | [PENDING] 대기 중 | [TOTAL] 총계
			</panel.string>
			<fs_scroll_list name="result_list">
				<fs_scroll_list.columns name="distance" label="거리" tool_tip="아바타에서 객체까지의 거리."/>
				<fs_scroll_list.columns name="name" label="이름"/>
				<fs_scroll_list.columns name="description" label="설명" width="170"/>
				<fs_scroll_list.columns name="price" label="가격" tool_tip="객체가 판매용인 경우 구매 가격."/>
				<fs_scroll_list.columns name="land_impact" label="LI" tool_tip="구획의 최대값에 차감되는 수치."/>
				<fs_scroll_list.columns name="prim_count" label="프림" tool_tip="객체를 구성하는 프리미티브 수."/>
				<fs_scroll_list.columns name="owner" label="소유자"/>
				<fs_scroll_list.columns name="group" label="그룹" tool_tip="객체가 설정된 그룹."/>
				<fs_scroll_list.columns name="creator" label="제작자" width="150"/>
				<fs_scroll_list.columns name="last_owner" label="이전 소유자" width="140" tool_tip="마지막으로 소유했던 사람."/>
			</fs_scroll_list>
			<button name="Refresh" label="새로고침" width="100"/>
			<text name="counter" left_delta="110">
				목록 | 대기 중 | 총계
			</text>
			<check_box name="beacons" label="비컨 표시" left_pad="90" width="170"/>
		</panel>
		<panel label="찾기" name="area_search_find_panel">
			<text name="name_label">
				이름:
			</text>
			<text name="desc_label">
				설명:
			</text>
			<text name="owner_label">
				소유자:
			</text>
			<text name="group_label">
				그룹:
			</text>
			<text name="creator_label">
				제작자:
			</text>
			<text name="last_owner_label">
				이전 소유자:
			</text>
			<check_box name="regular_expression" label="정규식 사용"/>
			<button name="search" label="검색"/>
			<button name="clear" label="지우기"/>
		</panel>
		<panel label="필터" name="area_search_filter_panel">
			<text name="only_list">
				다음 속성을 가진 객체만:
			</text>
			<check_box name="filter_locked" label="잠김"/>
			<check_box name="filter_physical" label="물리적"/>
			<check_box name="filter_phantom" label="팬텀"/>
			<check_box name="filter_temporary" label="임시"/>
			<check_box name="filter_attachment" label="어태치먼트"/>
			<check_box name="filter_moap" label="공유 미디어"/>
			<check_box name="filter_perm_copy" label="복사"/>
			<check_box name="filter_perm_modify" label="수정"/>
			<check_box name="filter_perm_transfer" label="전송"/>
			<check_box name="filter_reflection_probe" label="반사 프로브" tool_tip="수동 프로브만 포함하며 자동은 제외. 그래픽 설정에서 반사가 활성화된 경우만 반사 프로브 포함. 반사 범위가 설정되지 않았거나 프로브가 베이크되지 않은 경우 객체가 식별되지 않을 수 있습니다."/>
			<check_box name="filter_for_sale" label="판매가 다음 범위인" width="150"/>
			<text name="and">
				과
			</text>
			<text name="mouse_text">
				마우스 클릭 동작
			</text>
			<combo_box name="click_action" tool_tip="객체를 클릭했을 때 수행되는 동작.">
				<combo_box.item label=" " name="click_blank"/>
				<combo_box.item label="모든" name="click_any"/>
				<combo_box.item label="터치" name="click_touch"/>
				<combo_box.item label="앉기" name="click_sit"/>
				<combo_box.item label="구매" name="click_buy"/>
				<combo_box.item label="지불" name="click_pay"/>
				<combo_box.item label="열기" name="click_open"/>
				<combo_box.item label="재생" name="click_play"/>
				<combo_box.item label="미디어 열기" name="click_open_media"/>
				<combo_box.item label="확대" name="click_zoom"/>
			</combo_box>
			<check_box name="filter_distance" label="거리가 다음 범위인" width="140"/>
           <text name="and2">
				과
			</text>
			<check_box name="filter_agent_parcel_only" label="현재 구획만" width="140"/>
			<text name="only_list">
				다음 속성을 가진 객체 제외:
			</text>
			<check_box name="exclude_attachment" label="어태치먼트"/>
			<check_box name="exclude_physical" label="물리적"/>
			<check_box name="exclude_temporary" label="임시"/>
			<check_box name="exclude_reflection_probes" label="반사 프로브"/>
			<check_box name="exclude_childprim" label="자식 프리미티브"/>
			<check_box name="exclude_neighbor_region" label="인접 지역"/>
			<button name="apply" label="적용"/>
		</panel>
		<panel label="옵션" name="area_search_options_panel">
			<text name="display_column">
				표시할 열:
			</text>
			<check_box name="show_distance" label="거리"/>
			<check_box name="show_name" label="이름"/>
			<check_box name="show_description" label="설명"/>
			<check_box name="show_price" label="가격"/>
			<check_box name="show_land_impact" label="토지 영향"/>
			<check_box name="show_prim_count" label="프리미티브"/>
			<check_box name="show_owner" label="소유자"/>
			<check_box name="show_group" label="그룹"/>
			<check_box name="show_creator" label="제작자"/>
			<check_box name="show_last_owner" label="이전 소유자"/>
		</panel>
		<panel label="고급" name="area_search_advanced_panel">
			<check_box name="double_click_touch" label="더블 클릭으로 객체 터치"/>
			<check_box name="double_click_buy" label="더블 클릭으로 객체 구매"/>
			<check_box name="double_click_sit" label="더블 클릭으로 객체에 앉기"/>
		</panel>
	</tab_container>
</floater>
