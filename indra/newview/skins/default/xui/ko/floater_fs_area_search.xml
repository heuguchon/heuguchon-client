<?xml version='1.0' encoding='utf-8'?>
<floater name="area_search" title="오브젝트의 영역 검색">
	<tab_container name="area_searchtab">
		<panel label="리스트" name="area_search_list_panel">
			<panel.string name="ListedPendingTotalBlank">표시됨 | 가져오는 중 | 합계</panel.string>
			<panel.string name="ListedPendingTotalFilled">표시됨 [LISTED] | 취득 중 [PENDING] | 합계 [TOTAL]</panel.string>
			<fs_scroll_list name="result_list">
				<fs_scroll_list.columns name="distance" label="거리" />
				<fs_scroll_list.columns name="name" label="이름" />
				<fs_scroll_list.columns name="description" label="설명" />
				<fs_scroll_list.columns name="price" label="가격" tool_tip="오브젝트가 판매 대상인 경우, 구매 시 지불해야 하는 금액입니다." />
				<fs_scroll_list.columns name="land_impact" label="랜드임팩트" tool_tip="해당 토지가 받을 수 있는 최대 랜드 임팩트입니다." />
				<fs_scroll_list.columns name="prim_count" label="프림 수" tool_tip="각 오브젝트를 구성하는 프림의 수입니다." />
				<fs_scroll_list.columns name="owner" label="소유자" />
				<fs_scroll_list.columns name="group" label="그룹" tool_tip="오브젝트에 설정된 그룹 이름입니다." />
				<fs_scroll_list.columns name="creator" label="창작자" />
				<fs_scroll_list.columns name="last_owner" label="최종 소유자" tool_tip="마지막으로 오브젝트를 소유하고 있던 사람입니다." />
			</fs_scroll_list>
			<button name="Refresh" label="업데이트" />
			<text name="counter">표시됨 | 가져오는 중 | 합계</text>
			<check_box name="beacons" label="ビーコンを表示 - 비콘 표시" />
		</panel>
		<panel label="검색" name="area_search_find_panel">
			<text name="name_label">이름:</text>
			<text name="desc_label">설명:</text>
			<line_editor name="name_search" />
			<line_editor name="description_search" />
			<text name="owner_label">소유자:</text>
			<text name="group_label">그룹:</text>
			<line_editor name="owner_search" />
			<line_editor name="group_search" />
			<text name="creator_label">창조자:</text>
			<text name="last_owner_label">최종 소유자:</text>
			<line_editor name="creator_search" />
			<line_editor name="last_owner_search" />
			<check_box name="regular_expression" label="정규 표현식을 사용하세요" />
			<button name="search" label="검색" />
			<button name="clear" label="The provided text consists only of the Japanese word &quot;クリア,&quot; which translates to &quot;Clear&quot; in English. There is no mention of &quot;Firestorm&quot; in this text. Therefore, the translation of &quot;クリア&quot; to Korean is:&#10;&#10;명확한" />
		</panel>
		<panel label="필터" name="area_search_filter_panel">
			<text name="only_list">다음 조건의 오브젝트만:</text>
			<check_box name="filter_locked" label="록됨" />
			<check_box name="filter_physical" label="물리" />
			<check_box name="filter_phantom" label="팬텀" />
			<check_box name="filter_temporary" label="임시" />
			<check_box name="filter_attachment" label="아타치먼트" />
			<check_box name="filter_moap" label="共有メディア translates to 공동 미디어 in Korean. If the word 'Firestorm' appears, it should be translated to '흑우촌'." />
			<check_box name="filter_perm_copy" label="복사" />
			<check_box name="filter_perm_modify" label="수정" />
			<check_box name="filter_perm_transfer" label="재판매 및 선물" />
			<check_box name="filter_for_sale" label="다음 가격대에서 판매" />
			<spinner name="min_price" />
			<text name="and">Do you have a specific text that you want to be translated to Korean? Please provide the text you need to be translated, and I will be happy to assist you.</text>
			<spinner name="max_price" />
			<text name="mouse_text">마우스 클릭 시의 동작</text>
			<combo_box name="click_action" tool_tip="오브젝트를 클릭했을 때의 동작입니다.">
				<combo_box.item label="Sure, please provide the text you would like translated." name="click_blank" value="빈칸" />
				<combo_box.item label="모두" name="click_any" value="어떤" />
				<combo_box.item label="만지다" name="click_touch" value="터치" />
				<combo_box.item label="앉기" name="click_sit" value="앉기" />
				<combo_box.item label="사다" name="click_buy" value="구입" />
				<combo_box.item label="The text &quot;支払う&quot; translates to &quot;지불하다&quot; in Korean. &#10;&#10;In context with the SecondLife Viewer and the specific instruction to translate 'Firestorm' to '흑우촌', the translation is:&#10;&#10;支払う -&gt; 지불하다&#10;&#10;However, the provided text does not include 'Firestorm,' so there is no need to apply the special translation instruction in this case." name="click_pay" value="지불" />
				<combo_box.item label="열기" name="click_open" value="열기" />
				<combo_box.item label="연주하다" name="click_play" value="재생" />
				<combo_box.item label="미디어 열기" name="click_open_media" value="열기_미디어" />
				<combo_box.item label="줌" name="click_zoom" value="줌" />
			</combo_box>
			<check_box name="filter_distance" label="거리 범위" />
			<spinner name="min_distance" />
			<text name="and2">Please provide the text that you would like to be translated to Korean, specifically related to the SecondLife Viewer. If the word 'Firestorm' appears, it will be translated to '흑우촌' as you requested.</text>
			<spinner name="max_distance" />
			<check_box name="filter_agent_parcel_only" label="현재 있는 구역만" />
			<text name="only_list">다음 조건의 오브젝트를 제외:</text>
			<check_box name="exclude_attachment" label="첨부물" />
			<check_box name="exclude_physical" label="물리" />
			<check_box name="exclude_temporary" label="임시" />
			<check_box name="exclude_childprim" label="자식 프림" />
			<check_box name="exclude_neighbor_region" label="인접 지역" />
			<button name="apply" label="적용" />
		</panel>
		<panel label="옵션" name="area_search_options_panel">
			<text name="display_column">표시할 열:</text>
			<check_box name="show_distance" label="거림" />
			<check_box name="show_name" label="이름" />
			<check_box name="show_description" label="설명" />
			<check_box name="show_price" label="가격" />
			<check_box name="show_land_impact" label="Land Impact" />
			<check_box name="show_prim_count" label="프림 수" />
			<check_box name="show_owner" label="오너" />
			<check_box name="show_group" label="그룹" />
			<check_box name="show_creator" label="창작자" />
			<check_box name="show_last_owner" label="최종 소유자" />
		</panel>
		<panel label="상세" name="area_search_advanced_panel">
			<check_box name="double_click_touch" label="더블 클릭으로 오브젝트를 터치합니다" />
			<check_box name="double_click_buy" label="더블 클릭으로 오브젝트를 구입하세요" />
			<check_box name="double_click_sit" label="더블 클릭으로 객체에 앉기" />
		</panel>
	</tab_container>
</floater>