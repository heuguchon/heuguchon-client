<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel label="환경" name="panel_env_info">
	<string name="str_label_use_default">
		기본 설정 사용
	</string>
	<string name="str_label_use_region">
		지역 설정 사용
	</string>
	<string name="str_altitude_desription">
		하늘 [INDEX]([ALTITUDE]m)
	</string>
	<string name="str_no_parcel">
		토지가 선택되지 않았습니다. 환경 설정이 비활성화되었습니다.
	</string>
	<string name="str_cross_region">
		지역 경계를 넘어서는 환경 설정을 사용할 수 없습니다.
	</string>
	<string name="str_legacy">
		이 지역에서는 환경 설정을 사용할 수 없습니다
	</string>
	<string name="str_disallowed">
		부동산 관리자가 이 지역에서 토지 환경 변경을 허용하지 않습니다.
	</string>
	<string name="str_too_small">
		환경을 지원하려면 토지가 최소 128제곱미터여야 합니다.
	</string>
	<string name="str_empty">
		(비어 있음)
	</string>
	<string name="str_region_env">
		(지역 환경)
	</string>
	<layout_stack name="ls_main">
		<layout_panel name="pnl_environment_region_msg">
			<text name="region_text_lbl">
				지역:
			</text>
			<text name="region_text">
				알 수 없음
			</text>
		</layout_panel>
		<layout_panel name="pnl_environment_disabled">
			<text name="txt_environment_disabled">
				...
			</text>
		</layout_panel>
		<layout_panel name="pnl_environment_config">
			<layout_stack name="ls_environment_config">
				<layout_panel name="pnl_environment_config">
					<layout_stack name="ls_environment_config2">
						<layout_panel name="pnl_environment_current">
							<text name="select_environment_label">
								환경 선택
							</text>
							<button label="[USEDEFAULT]" name="btn_usedefault"/>
							<button label="인벤토리 사용" name="btn_select_inventory"/>
							<button label="주기 사용자 정의" name="btn_edit"/>
							<check_box label="토지 소유자 재정의 허용" name="chk_allow_override"/>
						</layout_panel>
						<layout_panel name="pnl_environment_length">
							<text name="day_settings_label">
								하루 설정
							</text>
							<text name="day_length_label">
								하루 길이 (시간)
							</text>
							<text name="day_offset_label">
								하루 오프셋 (시간)
							</text>
							<text name="apparent_time_of_day_label">
								보이는 시간:
							</text>
							<text name="lbl_apparent_time">
								[HH]:[MM][AP] ([PRC]%)
							</text>
						</layout_panel>
						<layout_panel name="pnl_environment_buttons"/>
					</layout_stack>
				</layout_panel>
				<layout_panel name="pnl_environment_altitudes">
					<panel name="pnl_alt1">
						<text name="txt_alt1">
							하늘 [INDEX]&#xA;[ALTITUDE]m
						</text>
						<line_editor name="edt_invname_alt1">
							알 수 없음
						</line_editor>
						<settings_drop_target name="sdt_alt1" tool_tip="인벤토리에서 설정을 이 대상 상자로 드래그하여 현재 하늘로 선택하세요."/>
					</panel>
					<panel name="pnl_alt2">
						<text name="txt_alt2">
							하늘 [INDEX]&#xA;[ALTITUDE]m
						</text>
						<line_editor name="edt_invname_alt2">
							알 수 없음
						</line_editor>
						<settings_drop_target name="sdt_alt2" tool_tip="인벤토리에서 설정을 이 대상 상자로 드래그하여 현재 하늘로 선택하세요."/>
					</panel>
					<panel name="pnl_alt3">
						<text name="txt_alt3">
							하늘 [INDEX]&#xA;[ALTITUDE]m
						</text>
						<line_editor name="edt_invname_alt3">
							알 수 없음
						</line_editor>
						<settings_drop_target name="sdt_alt3" tool_tip="인벤토리에서 설정을 이 대상 상자로 드래그하여 현재 하늘로 선택하세요."/>
					</panel>
					<text name="sky_altitudes_label">
						하늘 고도
					</text>
					<multi_slider initial_value="0" name="sld_altitudes">
						<slider name="sld1" value="1000"/>
						<slider name="sld2" value="2000"/>
						<slider name="sld3" value="3000"/>
					</multi_slider>
					<panel name="pnl_ground">
						<text name="txt_ground">
							지면
						</text>
						<line_editor name="edt_invname_ground">
							알 수 없음
						</line_editor>
						<settings_drop_target name="sdt_ground" tool_tip="인벤토리에서 설정을 이 대상 상자로 드래그하여 지면 수준 하늘로 선택하세요."/>
					</panel>
					<panel name="pnl_water">
						<text name="txt_water">
							물
						</text>
						<line_editor name="edt_invname_water">
							알 수 없음
						</line_editor>
						<settings_drop_target name="sdt_water" tool_tip="인벤토리에서 설정을 이 대상 상자로 드래그하여 현재 물로 선택하세요."/>
					</panel>
					<button label="재설정" name="btn_rst_altitudes" tool_tip="기본 고도로 재설정"/>
				</layout_panel>
			</layout_stack>
		</layout_panel>
	</layout_stack>
</panel>
