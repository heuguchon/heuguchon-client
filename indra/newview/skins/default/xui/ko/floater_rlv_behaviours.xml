<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater name="rlv_behaviours" title="활성 RLV 제한사항">
	<tab_container name="behaviour_tab">
		<panel label="제한사항" name="behaviour_panel">
			<scroll_list name="behaviour_list" tool_tip="현재 모든 RLVa 제한사항 목록">
				<scroll_list.columns label="제한사항" name="behaviour"/>
				<scroll_list.columns label="객체 이름" name="issuer"/>
			</scroll_list>
		</panel>
		<panel label="예외" name="exception_panel">
			<scroll_list name="exception_list" tool_tip="현재 모든 RLVa 예외 목록">
				<scroll_list.columns label="제한사항" name="behaviour"/>
				<scroll_list.columns label="옵션" name="option"/>
				<scroll_list.columns label="객체 이름" name="issuer"/>
			</scroll_list>
		</panel>
		<panel label="수정자" name="modifier_panel">
			<scroll_list name="modifier_list" tool_tip="현재 모든 RLVa 수정자 목록">
				<scroll_list.columns label="수정자" name="modifier"/>
				<scroll_list.columns label="값" name="value"/>
				<scroll_list.columns label="주 객체" name="primary" />
			</scroll_list>
		</panel>
	</tab_container>
	<panel name="bottom_panel">
		<button label="클립보드에 복사" name="copy_btn" tool_tip="제한사항을 클립보드로 복사" width="181"/>
		<icon name="dummy_icon" width="101"/>
	</panel>
</floater>
