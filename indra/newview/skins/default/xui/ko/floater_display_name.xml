<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="Display Name" title="표시 이름 변경">
	<floater.string name="LockOutDateFormat">
		[year,datetime,slt]년 [month,datetime,slt]월 [day,datetime,slt]일 [hour24,datetime,slt]:[min,datetime,slt]:[second,datetime,slt] [timezone,datetime,slt]
	</floater.string>
	<text name="info_text">
		표시 이름은 다른 사람들이 당신의 머리 위에서 보는 이름입니다. 로그인 이름과는 다릅니다. 일주일에 한 번 변경할 수 있습니다.
	</text>
	<text name="lockout_text">
		표시 이름을 변경할 수 있는 시간:
[TIME].
	</text>
	<text name="set_name_label">
		새 표시 이름:
	</text>
	<text name="name_confirm_label">
		새 이름을 다시 입력하여 확인하세요:
	</text>
	<button label="저장" name="save_btn" tool_tip="새 표시 이름을 저장합니다"/>
	<button label="재설정" name="reset_btn" tool_tip="사용자 이름을 표시 이름으로 사용"/>
	<button label="취소" name="cancel_btn"/>
</floater>
