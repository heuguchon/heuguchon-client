	<tab_container name="tabs">
		<panel label="근처" name="nearby_panel">
			<panel label="bottom_panel" name="nearby_buttons_panel">
				<filter_editor label="사람 필터" name="nearby_filter_input"/>
				<button name="gear_btn" tool_tip="선택한 사람에 대한 동작"/>
				<menu_button name="nearby_view_btn" tool_tip="보기/정렬 옵션"/>
				<button name="add_friend_btn" tool_tip="거주민에게 친구 요청하기"/>
				<dnd_button name="nearby_del_btn" tool_tip="선택한 사람을 친구에서 제거"/>
			</panel>
		</panel>
		<panel label="친구" name="friends_panel">
			<tab_container name="friends_accordion">
				<panel name="tab_online" title="온라인"/>
				<panel name="tab_all" title="전체"/>
				<panel name="tab_suggested_friends" title="친구 추천"/>
			</tab_container>
			<panel label="bottom_panel" name="friends_buttons_panel">
				<filter_editor label="사람 필터" name="friends_filter_input"/>
				<button name="gear_btn" tool_tip="선택한 사람에 대한 동작"/>
				<menu_button name="friends_view_btn" tool_tip="보기/정렬 옵션"/>
				<button name="friends_add_btn" tool_tip="거주민에게 친구 요청하기"/>
				<button name="GlobalOnlineStatusToggle" tool_tip="온라인 상태 표시 전역 전환"/>
				<dnd_button name="friends_del_btn" tool_tip="선택한 사람을 친구에서 제거"/>
			</panel>
				<accordion_tab name="tab_suggested_friends" title="친구 후보"/>
		</panel>
		<panel label="그룹" name="groups_panel">
			<panel label="bottom_panel" name="groups_buttons_panel">
				<filter_editor label="그룹 필터" name="groups_filter_input"/>
				<menu_button name="groups_gear_btn" tool_tip="선택한 그룹에 대한 동작"/>
				<menu_button name="groups_view_btn" tool_tip="보기/정렬 옵션"/>
				<menu_button name="plus_btn" tool_tip="그룹 가입/새 그룹 만들기"/>
				<dnd_button name="minus_btn" tool_tip="선택한 그룹 탈퇴"/>
			</panel>
			<text name="groupcount">
				당신은 [COUNT]개 그룹에 속해 있습니다 ([REMAINING]개 남음).
			</text>
		</panel>
		<panel label="최근" name="recent_panel">
			<panel label="bottom_panel" name="recent_buttons_panel">
				<filter_editor label="사람 필터" name="recent_filter_input"/>
				<button name="gear_btn" tool_tip="선택한 사람에 대한 동작"/>
				<menu_button name="recent_view_btn" tool_tip="보기/정렬 옵션"/>
				<button name="add_friend_btn" tool_tip="거주민에게 친구 요청하기"/>
				<dnd_button name="recent_del_btn" tool_tip="선택한 사람을 친구에서 제거"/>
			</panel>
		</panel>
		<panel label="차단됨" name="blocked_panel">
			<panel label="차단된 거주민 및 객체" name="panel_block_list_sidetray"/>
		</panel>
		<panel label="연락처 세트" name="contact_sets_panel">
			<panel label="연락처 세트" name="panel_people_contacts_sidetray"/>
		</panel>
	</tab_container>
</panel>
