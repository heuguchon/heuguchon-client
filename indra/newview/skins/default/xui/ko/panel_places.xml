<?xml version='1.0' encoding='utf-8'?>
<panel label="장소" name="places panel">
	<string name="landmarks_tab_title" value="내 랜드마크" />
	<string name="teleport_history_tab_title" value="텔레포트 기록" />
	<string name="favorites_tab_title" value="즐겨찾기" />
	<string name="tooltip_trash_items" value="선택한 랜드마크나 폴더를 삭제" />
	<string name="tooltip_trash_history" value="방문한 장소의 목록을 삭제" />
	<layout_stack name="places_layout_panel">
		<layout_panel name="main_panel">
			<layout_stack name="top_menu_panel">
				<layout_panel name="filter_panel">
					<filter_editor label="자신의 위치 필터링" name="Filter" />
				</layout_panel>
				<layout_panel name="options_gear_btn_panel">
					<menu_button tool_tip="옵션 표시" name="options_gear_btn" />
				</layout_panel>
				<layout_panel name="options_sort_btn_panel">
					<menu_button tool_tip="정렬 옵션 표시" name="sorting_menu_btn" />
				</layout_panel>
				<layout_panel name="add_btn_panel">
					<menu_button name="add_menu_btn" tool_tip="새로운 랜드마크나 폴더를 추가합니다" />
				</layout_panel>
				<layout_panel name="trash_btn_panel" tool_tip="선택한 랜드마크나 폴더를 삭제합니다">
					<dnd_button name="trash_btn" />
				</layout_panel>
			</layout_stack>
		</layout_panel>
		
		
		<layout_panel name="button_layout_panel">
			<panel name="button_panel">
				<layout_stack name="bottom_bar_ls0">
					<layout_panel name="lp1">
					
						
					
						<layout_stack name="bottom_bar_ls1">
							<layout_panel name="teleport_btn_lp">
								<button label="텔레포트" name="teleport_btn" tool_tip="해당 지역으로 텔레포트하기" />
							</layout_panel>
							<layout_panel name="chat_btn_lp">
								<button label="지도" name="map_btn" tool_tip="세계 지도에 해당하는 지역을 표시" />
							</layout_panel>
						</layout_stack>
					</layout_panel>
					
					<layout_panel name="lp_options">
						<menu_button name="overflow_btn" tool_tip="기타 옵션을 표시합니다" />
					</layout_panel>
					<layout_panel name="lp2">
						
						<layout_stack name="bottom_bar_close_ls3">
							<layout_panel name="close_btn_lp">
								<button label="닫기" name="close_btn" />
							</layout_panel>
						</layout_stack>
					</layout_panel>
				</layout_stack>
				
				<layout_stack name="bottom_bar_ls2">
					<layout_panel name="save_btn_lp">
						<button label="저장" name="save_btn" />
					</layout_panel>
					<layout_panel name="cancel_btn_lp">
						<button label="취소" name="cancel_btn" />
					</layout_panel>
				</layout_stack>
			</panel>
		</layout_panel>
	</layout_stack>
</panel>