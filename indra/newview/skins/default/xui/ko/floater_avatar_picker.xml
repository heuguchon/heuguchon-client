<?xml version='1.0' encoding='utf-8'?>
<floater min_width="275" name="avatarpicker" title="주민을 선택" width="275">
	<floater.string name="not_found">「[TEXT]」을(를) 찾을 수 없었습니다</floater.string>
	<floater.string name="not_found_text">주민을 찾을 수 없습니다.</floater.string>
	<floater.string name="no_one_near">주변에 아무도 없습니다</floater.string>
	<floater.string name="no_results">검색 결과: 제로</floater.string>
	<floater.string name="searching">검색 중...</floater.string>
	<string label="알겠습니다." label_selected="알겠습니다" name="Select">선택</string>
	<string name="Close">닫기</string>
	<tab_container name="ResidentChooserTabs" width="265">
		<panel label="검색" name="SearchPanel" width="145">
			<text name="InstructSearchResidentName">이름의 일부를 입력:</text>
			<button label="검색" label_selected="검색" name="Find" />
			<fs_scroll_list name="SearchResults">
				<columns label="이름" name="name" />
				<columns label="사용자 이름" name="username" />
			</fs_scroll_list>
		</panel>
		<panel label="프렌드" name="FriendsPanel">
			<text name="InstructSelectFriend">아바타 선택:</text>
			<fs_scroll_list name="Friends">
				<columns label="이름" name="name" />
				<columns label="사용자 이름" name="username" />
			</fs_scroll_list>
		</panel>
		<panel label="자신의 근처" name="NearMePanel" width="145">
			<text name="InstructSelectResident">근처 사람 선택:</text>
			<slider label="범위" name="near_me_range" />
			<text name="meters" width="50">미터</text>
			<fs_scroll_list name="NearMe">
				<columns label="이름" name="name" />
				<columns label="사용자 이름" name="username" />
			</fs_scroll_list>
		</panel>
	</tab_container>
	<button label="알겠습니다! &#10;&#10;텍스트를 제공해 주시겠습니까?" label_selected="Sure, please provide the text you would like to have translated to Korean, and I will translate it for you." name="ok_btn" />
	<button label="취소" label_selected="취소" name="cancel_btn" />
</floater>