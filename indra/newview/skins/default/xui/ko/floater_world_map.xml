<?xml version='1.0' encoding='utf-8'?>
<floater name="worldmap" title="세계 지도">
	<layout_stack name="resizing_stack">
		<layout_panel name="map_details_panel">
			<panel name="layout_panel_1">
				<text name="events_label">표기 · 기호</text>
			</panel>
			<panel name="layout_panel_2">
				<button label="현재 위치 표시" label_selected="현재 위치 표시" name="Show My Location" tool_tip="아바타의 위치를 지도 중심에 표시합니다." />
				<text name="me_label">자신</text>
				<check_box label="주민" name="people_chk" />
				<text name="person_label">주민</text>
				<check_box label="인포허브" name="infohub_chk" />
				<text name="infohub_label">인포허브</text>
				<check_box label="매각된 토지" name="land_for_sale_chk" />
				<text name="land_sale_label">토지 판매</text>
				<text name="auction_label">토지 경매</text>
				<text name="by_owner_label">소유자의 판매</text>
				<button label="홈으로" label_selected="홈으로" name="Go Home" tool_tip="「홈」으로 텔레포트합니다." />
				<text name="Home_label">홈</text>
				<text name="events_label">이벤트:</text>
				<check_box label="PG" name="event_chk" />
				<text name="pg_label">일반</text>
				<check_box initial_value="true" label="성숙함" name="events_mature_chk" />
				<text name="events_mature_label">보통</text>
				<check_box label="어른" name="events_adult_chk" />
				<text name="events_adult_label">성인</text>
			</panel>
			<panel name="layout_panel_3">
				<text name="find_on_map_label">지도에서 찾기</text>
			</panel>
			<panel name="layout_panel_4">
				<combo_box label="온라인의 친구" name="friend combo" tool_tip="친구를 지도에 표시">
					<combo_box.item label="온라인의 친구" name="item1" />
				</combo_box>
				<combo_box label="내 랜드마크" name="landmark combo" tool_tip="다음 텍스트를 고려하여 한국어로 번역해 주세요 &quot;SecondLife Viewer&quot;와 관련된 경우:&#10;'Firestorm'이라는 단어가 나타나면 '흑우촌'으로 번역해 주세요:&#10;&#10;지도에 랜드마크 표시">
					<combo_box.item label="내 랜드마크" name="item1" />
				</combo_box>
				<search_editor label="지역 이름" name="location" tool_tip="리전 이름을 입력합니다" />
				<button label=" 검색" name="DoSearch" tool_tip="리전 검색" />
				<scroll_list name="search_results">
					<scroll_list.columns label="물론입니다. 텍스트를 입력해 주세요." name="icon" />
					<scroll_list.columns label="물론이죠! 여기 제공된 텍스트를 한국어로 번역하겠습니다. 'Firestorm'이라는 단어는 '흑우촌'으로 번역하겠습니다.&#10;&#10;Please provide the text you would like to be translated." name="sim_name" />
				</scroll_list>
				<text name="events_label">장소:</text>
				<button label="텔레포트" label_selected="텔레포트" name="Teleport" tool_tip="선택한 장소로 텔레포트합니다" />
				<button label="SLurl 을 복사" name="copy_slurl" tool_tip="현재 위치의 SLurl을 복사하여 웹에서 사용합니다." />
				<button label="삭제" name="Clear" tool_tip="추적 라인을 지우고 지도를 재설정합니다." />
				<button label="선택을 표시하기" label_selected="목적지를 표시" name="Show Destination" tool_tip="선택한 장소를 지도의 중심에 표시합니다" />
				<button label="목록에 추가" name="track_region" tool_tip="이 지역을 지역별 아바타 수의 목록에 추가합니다." />
			</panel>
		</layout_panel> 
	</layout_stack> 
</floater>