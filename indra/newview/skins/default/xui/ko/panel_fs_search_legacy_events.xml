<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<panel label="이벤트" name="panel_ls_events">
	<panel name="panel_ls_input">
		<text name="search_text">
			검색어를 입력하세요:
		</text>
		<radio_group name="events_search_mode">
			<radio_item label="현재 및 예정" name="current"/>
			<radio_item	label="날짜별" name="date"/>
		</radio_group>
		<combo_box name="events_category">
			<combo_box.item label="모든 카테고리" name="any"/>
			<combo_box.item label="토론" name="discussion"/>
			<combo_box.item label="스포츠" name="sports"/>
			<combo_box.item label="라이브 음악" name="music"/>
			<!-- <combo_box.item label="???" name="mystery_category"/> -->
			<combo_box.item label="상업적" name="commercial"/>
			<combo_box.item label="나이트라이프/엔터테인먼트" name="nightlife"/>
			<combo_box.item label="게임/경기" name="games"/>
			<combo_box.item label="미인 대회" name="pageants"/>
			<combo_box.item label="교육" name="education"/>
			<combo_box.item label="예술 및 문화" name="arts"/>
			<combo_box.item label="자선/지원 그룹" name="charity"/>
			<combo_box.item label="기타" name="misc"/>
		</combo_box>
	</panel>
	<!-- Search Pane -->
	<panel name="panel_ls_scrolllist">
		<scroll_list name="search_results_events">
			<columns label="" name="icon"/>
			<columns label="이벤트명" name="event_name"/>
			<columns label="날짜/시간" name="date"/>
			<columns label="시각" name="time"/>
		</scroll_list>
		<button label="어제" name="events_yesterday"/>
		<button label="오늘" name="events_today"/>
		<button label="내일" name="events_tomorrow"/>
		<button label="뒤로" name="events_back"/>
		<button label="다음" name="events_next"/>
	</panel>
</panel>
