<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel label="추천장소" name="panel_picks">
	<string name="no_picks" value="추천장소 없음"/>

	<layout_stack name="main_stack">
		<layout_panel name="buttons_header">
			<text name="header_text">
				[GRID]에서 가장 좋아하는 장소를 소개해 주세요.
			</text>
			<button label="신규..." tool_tip="현재 위치에 새 추천장소 생성" name="new_btn"/>
			<button label="삭제..." tool_tip="현재 선택한 추천장소 삭제" name="delete_btn"/>
		</layout_panel>
		<layout_panel name="main_body">
			<text name="picks_panel_text">
				로딩 중...
			</text>
		</layout_panel>
	</layout_stack>
</panel>
