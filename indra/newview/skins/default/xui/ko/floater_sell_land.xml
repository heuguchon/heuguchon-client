<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="sell land" title="토지 판매">
	<scroll_container name="profile_scroll">
		<panel name="scroll_content_panel">
			<text name="info_parcel_label">
				구획:
			</text>
			<text name="info_parcel">
				구획 이름
			</text>
			<text name="info_size_label">
				크기:
			</text>
			<text name="info_size">
				[AREA]㎡
			</text>
			<text name="info_action">
				이 구획을 판매하려면:
			</text>
			<text name="price_label">
				1. 가격 설정:
			</text>
			<text name="price_text" >
				가격을 입력하세요
			</text>
			<text name="price_ld">
				L$
			</text>
			<line_editor name="price">
				0
			</line_editor>
			<text name="price_per_m">
				(㎡당 L$[PER_METER])
			</text>
			<text name="sell_to_label">
				2. 토지 판매 대상:
			</text>
			<text name="sell_to_text">
				공개 판매 또는 특정 사람에게 판매하시겠습니까?
			</text>
			<combo_box name="sell_to">
				<combo_box.item label="-- 선택하세요 --" name="--selectone--"/>
				<combo_box.item label="누구에게나" name="Anyone"/>
				<combo_box.item label="특정 사람:" name="Specificuser:"/>
			</combo_box>
			<button label="선택" name="sell_to_select_agent"/>
			<text name="sell_objects_label">
				3. 객체를 토지와 함께 판매하시겠습니까?
			</text>
			<text name="sell_objects_text">
				구획에 있는 양도 가능한 토지 소유자 객체의 소유권이 이전됩니다.
			</text>
			<radio_group name="sell_objects">
				<radio_item label="아니요, 객체 보유" name="no"/>
				<radio_item label="예, 객체를 토지와 함께 판매" name="yes"/>
			</radio_group>
			<button label="객체 표시" name="show_objects"/>
			<text name="nag_message_label">
				경고: 판매는 최종적이며 되돌릴 수 없습니다.
			</text>
			<button label="판매하기" name="sell_btn"/>
			<button label="취소" name="cancel_btn"/>
		</panel>
	</scroll_container>
</floater>
