<?xml version='1.0' encoding='utf-8'?>
<floater name="track picker" title="트럭 선택">
	<layout_stack name="adjuster">
		<layout_panel name="pnl_desc">
			<text name="select_description">소스 선택 비어 있음:</text>
		</layout_panel>
		<layout_panel name="pnl_traks">
			<radio_group name="track_selection">
				<radio_item label="공백 4 [ALT]" name="radio_sky4" />
				<radio_item label="공중 3 [ALT]" name="radio_sky3" />
				<radio_item label="공백 2 [ALT]" name="radio_sky2" />
				<radio_item label="지상" name="radio_sky1" />
			</radio_group>
		</layout_panel>
		<layout_panel name="pnl_ok_cancel">
			<button label="알겠습니다." label_selected="OK" name="btn_select" />
			<button label="취소" label_selected="취소" name="btn_cancel" />
		</layout_panel>
	</layout_stack>
</floater>