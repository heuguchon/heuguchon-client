<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="track picker" title="트랙 선택">
	<layout_stack name="adjuster">
		<layout_panel name="pnl_desc">
			<text name="select_description">
				원본 하늘 선택:
			</text>
		</layout_panel>
		<layout_panel name="pnl_traks">
			<radio_group name="track_selection">
				<radio_item label="하늘4 [ALT]" name="radio_sky4" value="4"/>
				<radio_item label="하늘3 [ALT]" name="radio_sky3" value="3"/>
				<radio_item label="하늘2 [ALT]" name="radio_sky2" value="2"/>
				<radio_item label="지상" name="radio_sky1" value="1"/>
			</radio_group>
		</layout_panel>
		<layout_panel name="pnl_ok_cancel">
			<button label="확인" label_selected="확인" name="btn_select"/>
			<button label="취소" label_selected="취소" name="btn_cancel"/>
		</layout_panel>
	</layout_stack>
</floater>
