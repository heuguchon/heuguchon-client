<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="Scene Load Statistics" title="씬 로딩 통계">
	<button label="일시정지" name="playpause"/>
	<scroll_container name="statistics_scroll">
		<container_view name="statistics_view">
			<stat_view label="기본" name="basic">
				<stat_bar label="프레임 픽셀 차이" name="frame difference"/>
				<stat_bar label="수신된 UDP 데이터" name="bandwidth"/>
				<stat_bar label="패킷 손실" name="packet_loss"/>
			</stat_view>
			<stat_view label="고급" name="advanced">
				<stat_view label="렌더링" name="render">
					<stat_bar label="객체 수" name="objs"/>
					<stat_bar label="새 객체" name="newobjs"/>
					<stat_bar label="객체 캐시 적중률" name="object_cache_hits"/>
				</stat_view>
				<stat_view label="텍스처" name="texture">
					<stat_bar label="캐시 적중률" name="texture_cache_hits"/>
					<stat_bar label="캐시 읽기 지연" name="texture_cache_read_latency"/>
					<stat_bar label="캐시 디코딩 지연" name="texture_decode_latency"/>
					<stat_bar label="캐시 쓰기 지연" name="texture_write_latency"/>
					<stat_bar label="개수" name="numimagesstat"/>
					<stat_bar label="원본 개수" name="numrawimagesstat"/>
				</stat_view>
				<stat_view label="네트워크" name="network">
					<stat_bar label="패킷 입력" name="packetsinstat"/>
					<stat_bar label="패킷 출력" name="packetsoutstat"/>
					<stat_bar label="객체" name="objectdatareceived"/>
					<stat_bar label="텍스처" name="texturedatareceived"/>
					<stat_bar label="자산" name="assetudpdatareceived"/>
					<stat_bar label="레이어" name="layersdatareceived"/>
					<stat_bar label="실제 입력" name="messagedatain"/>
					<stat_bar label="실제 출력" name="messagedataout"/>
				</stat_view>
			</stat_view>
			<stat_view label="시뮬레이터" name="sim">
				<stat_bar label="객체" name="simobjects"/>
				<stat_bar label="활성 객체" name="simactiveobjects"/>
				<stat_bar label="활성 스크립트" name="simactivescripts"/>
				<stat_bar label="패킷 입력" name="siminpps"/>
				<stat_bar label="패킷 출력" name="simoutpps"/>
				<stat_bar label="대기 중인 다운로드" name="simpendingdownloads"/>
				<stat_bar label="대기 중인 업로드" name="simpendinguploads"/>
				<stat_bar label="총 미확인 바이트" name="simtotalunackedbytes"/>
				<stat_view label="시간 (ms)" name="simperf">
					<stat_bar label="총 프레임 시간" name="simframemsec"/>
					<stat_bar label="네트워크 시간" name="simnetmsec"/>
					<stat_bar label="물리 시간" name="simsimphysicsmsec"/>
					<stat_bar label="시뮬레이션 시간" name="simsimothermsec"/>
					<stat_bar label="에이전트 시간" name="simagentmsec"/>
					<stat_bar label="이미지 시간" name="simimagesmsec"/>
					<stat_bar label="스크립트 시간" name="simscriptmsec"/>
					<stat_bar label="여분 시간" name="simsparemsec"/>
					<stat_view label="시간 세부사항 (ms)" name="timedetails">
						<stat_bar label="물리 스텝" name="simsimphysicsstepmsec"/>
						<stat_bar label="물리 형태 업데이트" name="simsimphysicsshapeupdatemsec"/>
						<stat_bar label="물리 - 기타" name="simsimphysicsothermsec"/>
						<stat_bar label="대기 시간" name="simsleepmsec"/>
						<stat_bar label="펌프 IO" name="simpumpiomsec"/>
					</stat_view>
				</stat_view>
			</stat_view>
		</container_view>
	</scroll_container>
</floater>
