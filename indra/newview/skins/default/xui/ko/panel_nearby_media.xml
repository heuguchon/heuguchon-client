<?xml version='1.0' encoding='utf-8'?>
<panel name="nearby_media">
	<string name="media_item_count_format">（미디어 항목 %ld）</string>
	<string name="empty_item_text">&lt;빈공간&gt;</string>
	<string name="parcel_media_name">구획 스트리밍 미디어</string>
	<string name="parcel_audio_name">구획 스트리밍 오디오</string>
	<string name="playing_suffix">（재생 중）</string>
	<panel name="minimized_controls">
		<button label="모두 중지" name="all_nearby_media_disable_btn" tool_tip="주변 미디어를 모두 꺼집니다." />
		<button label="모두 시작" name="all_nearby_media_enable_btn" tool_tip="근처의 미디어를 모두 켭니다" />
		<button name="open_prefs_btn" tool_tip="미디어 설정을 엽니다." />
		<button label="상세　≫" label_selected="≪　간이" name="more_btn" tool_tip="확장 컨트롤" />
		<button label="자세히 보기　≫" label_selected="잘못된 문자입니다. 로마자(알파벳)로만 이루어진 텍스트를 입력해야 합니다. 'Firestorm'을 '흑우촌'으로 번역해 드리겠습니다.&#10;&#10;≪　簡易" name="less_btn" tool_tip="확장 컨트롤" />
	</panel>
	<panel name="nearby_media_panel">
		<text name="nearby_media_title">근처 미디어</text>
		<text name="show_text">화면 표시:</text>
		<combo_box name="show_combo">
			<combo_box.item label="모두" name="All" />
			<combo_box.item label="이 구획 내" name="WithinParcel" />
			<combo_box.item label="이 구역 밖" name="OutsideParcel" />
			<combo_box.item label="他のアバター --&gt; 다른 아바타&#10;&#10;Note: There was no mention of 'Firestorm' in the provided text. If you have more text or another specific instance where 'Firestorm' appears, please provide it for accurate translation and replacement." name="OnOthers" />
		</combo_box>
		<scroll_list name="media_list">
			<scroll_list.columns label="근접" name="media_proximity" />
			<scroll_list.columns label="표시" name="media_visibility" />
			<scroll_list.columns label="클라스" name="media_class" />
			<scroll_list.columns label="이름" name="media_name" />
			<scroll_list.columns label="디버그" name="media_debug" />
		</scroll_list>
		<panel name="media_controls_panel">
			<layout_stack name="media_controls">
				<layout_panel name="stop">
					<button name="stop_btn" tool_tip="선택한 미디어를 중지" />
				</layout_panel>
				<layout_panel name="play">
					<button name="play_btn" tool_tip="선택한 미디어를 재생" />
				</layout_panel>
				<layout_panel name="pause">
					<button name="pause_btn" tool_tip="선택한 미디어를 일시 정지" />
				</layout_panel>
				<layout_panel name="volume_slider_ctrl">
					<slider_bar name="volume_slider" tool_tip="선택한 미디어의 음량" />
				</layout_panel>
				<layout_panel name="mute">
					<button name="mute_btn" tool_tip="선택한 미디어의 소리를 음소거" />
				</layout_panel>
				<layout_panel name="zoom">
					<button name="zoom_btn" tool_tip="선택한 미디어에 줌" />
				</layout_panel>
				<layout_panel name="unzoom">
					<button name="unzoom_btn" tool_tip="선택한 미디어에서 멀어지기" />
				</layout_panel>
			</layout_stack>
		</panel>
	</panel>
</panel>